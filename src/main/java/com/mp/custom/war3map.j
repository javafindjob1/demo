function InitTrig_5_____________u takes nothing returns nothing
	set gg_trg_5_____________u=CreateTrigger()
	call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg_5_____________u)
	call TriggerAddCondition(gg_trg_5_____________u, Condition(function Trig_5_____________uConditions))
	call TriggerAddAction(gg_trg_5_____________u, function Trig_5_____________uActions)
endfunction
