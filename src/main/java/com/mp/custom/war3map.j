//library YDWEYDWEJapiScript:


//library YDWEYDWEJapiScript ends
//library EC:

    //private:
    //public:
    function EC_DestroyEffect takes effect e returns nothing
        call EXSetEffectXY(e, 99999, 99999)
        call DestroyEffect(e)
    endfunction
    function EC_A1 takes real a,real b,real c,real t returns real
        return Pow(( 1 - t ), 2) * a + 2 * t * ( 1 - t ) * b + Pow(t, 2) * c
    endfunction
    function EC_GetHeight takes integer steeps,integer steepsMax,real heightMax,real fly returns real
        local real dheig=1.0 / steepsMax
        return ( - ( 2 * I2R(steeps) * dheig - 1 ) * ( 2 * I2R(steeps) * dheig - 1 ) + 1 ) * heightMax + fly
    endfunction  //获取坐标位置的Z轴高度
    function EC_GetPointZ takes real x,real y returns real
        if ( EC___Star_Location == null ) then
            set EC___Star_Location=Location(x, y)
        else
            call MoveLocation(EC___Star_Location, x, y)
        endif
        return GetLocationZ(EC___Star_Location)
    endfunction
    function EC___EC_TimerEvent takes nothing returns nothing
        local unit u
        local real x
        local real y
        local real z
        local integer tempi=0
        local integer tempmax=0
        local real tempr=0
        local integer index
        local integer i2=0
        if ( EC_Index > 0 ) then
            set index=EC_Index - 1
            set EC___i=0
            loop
            exitwhen ( EC___i > index )
                call SaveInteger(EC_HT, GetHandleId(EC_EffectList[EC___i]), 1000, EC___i)
                set EC_Exit=false
                set EC_ShiledExit=false
                set tempi=0
                if ( EC_Speed[EC___i] > 31 ) then
                    set tempmax=R2I(EC_Speed[EC___i] / 31)
                    set tempr=ModuloReal(EC_Speed[EC___i], 31) //BJDebugMsg("tempmax = "+I2S(tempmax) + "tempi = "+I2S(tempi));
                else
                    set tempmax=0
                    set tempr=EC_Speed[EC___i]
                endif //移动特效 默认的移动模式
                if ( EC_MoveMode[EC___i] == 0 ) then
                    loop //特效移动部分
                    exitwhen ( tempi >= tempmax )
                        if ( EC_Exit ) then
                            exitwhen true //移动特效
                        endif
                        set tempi=tempi + 1 //BJDebugMsg("tempmax = "+I2S(tempmax) + "tempi = "+I2S(tempi));
                        set x=EXGetEffectX(EC_EffectList[EC___i]) + CosBJ(EC_D[EC___i]) * 31
                        set y=EXGetEffectY(EC_EffectList[EC___i]) + SinBJ(EC_D[EC___i]) * 31
                        if ( EC_PZ[EC___i] ) then
                            if ( not ( X_IsTerrainWalkable(x , y) ) ) then
                                if ( EC_PZTrig[EC___i] != null ) then
                                    set EC_TargetEffect=EC_EffectList[EC___i]
                                    set EC_EventID=3
                                    call TriggerExecute(EC_PZTrig[EC___i])
                                else
                                    set EC_Exit=true //停止移动，运行结束触发器
                                    set tempi=tempmax
                                endif
                            else
                                call EXSetEffectXY(EC_EffectList[EC___i], x, y)
                            endif
                        else
                            call EXSetEffectXY(EC_EffectList[EC___i], x, y)
                        endif //特效高度设置
                        if ( EC_FlyMode[EC___i] != 2 ) then // =2为自定义 即 不设置
                            set z=EC_GetPointZ(x , y) //保持特效相对地面高度
                            if ( EC_FlyMode[EC___i] == 0 ) then
                                call EXSetEffectZ(EC_EffectList[EC___i], z + EC_Height[EC___i])
                            elseif ( EC_FlyMode[EC___i] == 1 ) then
                                set EC_steeps[EC___i]=EC_steeps[EC___i] + 1 //抛物线
                                call EXSetEffectZ(EC_EffectList[EC___i], z + EC_GetHeight(EC_steeps[EC___i] , EC_steepsMax[EC___i] , EC_Height[EC___i] , z)) //BJDebugMsg(R2S(EXGetEffectZ(EC_EffectList[i])));
                            endif
                        endif
                        set i2=0 //检查护盾
                        loop //BJDebugMsg("i2 =:"+I2S(i2)+",Index = "+I2S(EC_ShiledIndex));
                        exitwhen ( i2 >= EC_ShiledIndex )
                            if ( not ( IsUnitAlly(EC_ShiledArray[i2], EC_OwnningPlayer[EC___i]) ) ) then //BJDebugMsg("i2 =:"+I2S(i2)+",Index = "+I2S(EC_ShiledIndex)); //友方护盾则不检查
                                if ( X_GDBC(x , y , GetUnitX(EC_ShiledArray[i2]) , GetUnitY(EC_ShiledArray[i2])) <= EC_ShiledSize[i2] ) then //检查弹幕与护盾的距离 小于 护盾尺寸 //特效x,y 与 护盾单位 x y 的距离  <= size
                                    set EC_TargetEffect=EC_EffectList[EC___i] //BJDebugMsg("触碰到护盾了！"); //弹幕处于护盾范围内 运行护盾触碰弹幕回调 //触发特效 //触发特效所有者
                                    set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC___i] //触发护盾
                                    set EC_TargetUnit=EC_ShiledArray[i2] //事件ID
                                    set EC_EventID=4 //运行回调
                                    call TriggerExecute(EC_ShiledCallbackTrig[i2])
                                endif
                            endif
                            set i2=i2 + 1
                        endloop //弹幕触碰部分
                        if ( EC_DamageTrig[EC___i] != null ) then
                            if ( not EC_Exit ) then
                                call GroupEnumUnitsInRange(EC___g, x, y, EC_Range[EC___i], null) //选取单位做动作
                                set u=FirstOfGroup(EC___g)
                                loop
                                exitwhen ( u == null )
                                    set EC_TargetUnit=u //触发单位 //触发特效
                                    set EC_TargetEffect=EC_EffectList[EC___i]
                                    set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC___i]
                                    set EC_EventID=0
                                    call TriggerExecute(EC_DamageTrig[EC___i]) //如果结束本次冲锋，则直接结束
                                    if ( EC_Exit ) then
                                        exitwhen true
                                    endif
                                    call GroupRemoveUnit(EC___g, u)
                                    set u=FirstOfGroup(EC___g)
                                endloop
                                call GroupClear(EC___g)
                            endif
                        endif
                        if ( EC_Mode[EC___i] != 0 ) then
                            set EC_DisD[EC___i]=EC_DisD[EC___i] + 31
                        else
                            set EC_DisD[EC___i]=EC_DisD[EC___i] + 31 //距离退出模式
                        endif //检查冲锋是否需要结束
                        if ( ( EC_Mode[EC___i] != 0 and EC_Timed[EC___i] >= EC_TimeMax[EC___i] ) or ( EC_Mode[EC___i] == 0 and EC_DisD[EC___i] >= EC_Distance[EC___i] ) or EC_Exit ) then
                            set EC_Exit=true //冲锋结束
                            set EC_KeepALive=false //检查是否需要调用指定结束触发器
                            if ( EC_FinishTrig[EC___i] != null ) then
                                set EC_TargetUnit=null
                                set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC___i]
                                set EC_TargetEffect=EC_EffectList[EC___i]
                                call FlushChildHashtable(EC_HT, GetHandleId(EC_TargetEffect))
                                set EC_EventID=1
                                call TriggerExecute(EC_FinishTrig[EC___i])
                            else
                                call DestroyEffect(EC_EffectList[EC___i])
                            endif //是否保持特效存在
                            if ( not EC_KeepALive ) then
                                if ( EC___i != index ) then //当前数据不在顶部 //清除特效数据
                                    set EC_D[EC___i]=EC_D[index] //移动变量位置
                                    set EC_Height[EC___i]=EC_Height[index]
                                    set EC_DamageTrig[EC___i]=EC_DamageTrig[index]
                                    set EC_FinishTrig[EC___i]=EC_FinishTrig[index]
                                    set EC_Mode[EC___i]=EC_Mode[index]
                                    set EC_Distance[EC___i]=EC_Distance[index]
                                    set EC_DisD[EC___i]=EC_DisD[index]
                                    set EC_Timed[EC___i]=EC_Timed[index]
                                    set EC_TimeMax[EC___i]=EC_TimeMax[index]
                                    set EC_Speed[EC___i]=EC_Speed[index]
                                    set EC_OwnningPlayer[EC___i]=EC_OwnningPlayer[index]
                                    set EC_EffectList[EC___i]=EC_EffectList[index]
                                    set EC_BrushTrig[EC___i]=EC_BrushTrig[index]
                                    set EC_Brush[EC___i]=EC_Brush[index]
                                    set EC_BrushTime[EC___i]=EC_BrushTime[index]
                                    set EC_BrushDis[EC___i]=EC_BrushDis[index]
                                    set EC_PZ[EC___i]=EC_PZ[index]
                                    set EC_PZTrig[EC___i]=EC_PZTrig[index]
                                    set EC_FlyMode[EC___i]=EC_FlyMode[index]
                                    set EC_steeps[EC___i]=EC_steeps[index]
                                    set EC_steepsMax[EC___i]=EC_steepsMax[index]
                                    set EC_MoveMode[EC___i]=EC_MoveMode[index] //顶部计数-1
                                    call SaveInteger(EC_HT, GetHandleId(EC_EffectList[EC___i]), 1000, EC___i)
                                    set EC_Index=EC_Index - 1
                                    set index=EC_Index - 1
                                    if ( index > 0 ) then
                                        set EC___i=EC___i - 1
                                    endif
                                else
                                    set EC_Index=EC_Index - 1 //在顶部只需要使顶部计数-1 //顶 - 1
                                    set index=EC_Index - 1
                                endif
                            endif
                        endif
                    endloop
                endif
                if ( not EC_Exit ) then
                    if ( EC_MoveMode[EC___i] == 0 ) then //移动特效 默认模式
                        set x=EXGetEffectX(EC_EffectList[EC___i]) + CosBJ(EC_D[EC___i]) * tempr
                        set y=EXGetEffectY(EC_EffectList[EC___i]) + SinBJ(EC_D[EC___i]) * tempr
                    endif
                    if ( EC_PZ[EC___i] ) then
                        if ( not ( X_IsTerrainWalkable(x , y) ) ) then
                            if ( EC_PZTrig[EC___i] != null ) then
                                set EC_TargetEffect=EC_EffectList[EC___i]
                                set EC_EventID=3
                                call TriggerExecute(EC_PZTrig[EC___i])
                            else
                                set EC_Exit=true //停止移动，运行结束触发器
                                set tempi=tempmax
                            endif
                        else
                            call EXSetEffectXY(EC_EffectList[EC___i], x, y)
                        endif
                    else
                        call EXSetEffectXY(EC_EffectList[EC___i], x, y)
                    endif
                    if ( EC_FlyMode[EC___i] != 2 ) then //特效高度设置 // =2为自定义 即 不设置
                        set z=EC_GetPointZ(x , y) //保持特效相对地面高度
                        if ( EC_FlyMode[EC___i] == 0 ) then
                            call EXSetEffectZ(EC_EffectList[EC___i], z + EC_Height[EC___i])
                        elseif ( EC_FlyMode[EC___i] == 1 ) then
                            set EC_steeps[EC___i]=EC_steeps[EC___i] + 1 //抛物线
                            call EXSetEffectZ(EC_EffectList[EC___i], z + EC_GetHeight(EC_steeps[EC___i] , EC_steepsMax[EC___i] , EC_Height[EC___i] , z)) //BJDebugMsg(R2S(EXGetEffectZ(EC_EffectList[i])));
                        endif
                    endif
                    set i2=0 //检查护盾
                    loop //BJDebugMsg("i2 =:"+I2S(i2)+",Index = "+I2S(EC_ShiledIndex));
                    exitwhen ( i2 >= EC_ShiledIndex )
                        if ( not ( IsUnitAlly(EC_ShiledArray[i2], EC_OwnningPlayer[EC___i]) ) ) then //BJDebugMsg("i2 =:"+I2S(i2)+",Index = "+I2S(EC_ShiledIndex)); //友方护盾则不检查
                            if ( X_GDBC(x , y , GetUnitX(EC_ShiledArray[i2]) , GetUnitY(EC_ShiledArray[i2])) <= EC_ShiledSize[i2] ) then //检查弹幕与护盾的距离 小于 护盾尺寸 //特效x,y 与 护盾单位 x y 的距离  <= size
                                set EC_TargetEffect=EC_EffectList[EC___i] //BJDebugMsg("触碰到护盾了！"); //弹幕处于护盾范围内 运行护盾触碰弹幕回调 //触发特效 //触发特效所有者
                                set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC___i] //触发护盾
                                set EC_TargetUnit=EC_ShiledArray[i2] //事件ID
                                set EC_EventID=4 //运行回调
                                call TriggerExecute(EC_ShiledCallbackTrig[i2])
                            endif
                        endif
                        set i2=i2 + 1
                    endloop //弹幕触碰部分
                    if ( EC_DamageTrig[EC___i] != null ) then
                        if ( not EC_Exit ) then
                            call GroupEnumUnitsInRange(EC___g, x, y, EC_Range[EC___i], null) //选取单位做动作
                            set u=FirstOfGroup(EC___g)
                            loop
                            exitwhen ( u == null )
                                set EC_TargetUnit=u //触发单位 //触发特效
                                set EC_TargetEffect=EC_EffectList[EC___i]
                                set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC___i]
                                set EC_EventID=0
                                call TriggerExecute(EC_DamageTrig[EC___i]) //如果结束本次冲锋，则直接结束
                                if ( EC_Exit ) then
                                    exitwhen true
                                endif
                                call GroupRemoveUnit(EC___g, u)
                                set u=FirstOfGroup(EC___g)
                            endloop
                            call GroupClear(EC___g)
                        endif
                    endif
                    if ( EC_Mode[EC___i] != 0 ) then
                        set EC_Timed[EC___i]=EC_Timed[EC___i] + 0.02 //时间退出模式
                        set EC_DisD[EC___i]=EC_DisD[EC___i] + tempr
                    else
                        set EC_DisD[EC___i]=EC_DisD[EC___i] + tempr //距离退出模式
                    endif //刷新特效
                    if ( EC_Brush[EC___i] ) then
                        set EC_BrushTime[EC___i]=EC_BrushTime[EC___i] + 0.02 //计算周期
                        if ( EC_BrushTime[EC___i] >= EC_BrushDis[EC___i] ) then
                            set EC_BrushTime[EC___i]=0
                            set EC_EventID=2
                            set EC_TargetEffect=EC_EffectList[EC___i]
                            if ( EC_BrushTrig[EC___i] != null ) then
                                call TriggerExecute(EC_BrushTrig[EC___i])
                            endif
                        endif
                    endif //检查冲锋是否需要结束
                    if ( ( EC_Mode[EC___i] != 0 and EC_Timed[EC___i] >= EC_TimeMax[EC___i] ) or ( EC_Mode[EC___i] == 0 and EC_DisD[EC___i] >= EC_Distance[EC___i] ) or EC_Exit ) then
                        set EC_KeepALive=false //冲锋结束 //检查是否需要调用指定结束触发器
                        if ( EC_FinishTrig[EC___i] != null ) then
                            set EC_TargetUnit=null
                            set EC_EffectOwnningPlayer=EC_OwnningPlayer[EC___i]
                            set EC_TargetEffect=EC_EffectList[EC___i] //清除ID接口
                            call FlushChildHashtable(EC_HT, GetHandleId(EC_TargetEffect))
                            set EC_EventID=1
                            call TriggerExecute(EC_FinishTrig[EC___i])
                        else
                            call DestroyEffect(EC_EffectList[EC___i])
                        endif //是否保持特效存在
                        if ( not EC_KeepALive ) then
                            if ( EC___i != index ) then //当前数据不在顶部 //清除特效数据
                                set EC_D[EC___i]=EC_D[index] //移动变量位置
                                set EC_Height[EC___i]=EC_Height[index]
                                set EC_DamageTrig[EC___i]=EC_DamageTrig[index]
                                set EC_FinishTrig[EC___i]=EC_FinishTrig[index]
                                set EC_Mode[EC___i]=EC_Mode[index]
                                set EC_Distance[EC___i]=EC_Distance[index]
                                set EC_DisD[EC___i]=EC_DisD[index]
                                set EC_Timed[EC___i]=EC_Timed[index]
                                set EC_TimeMax[EC___i]=EC_TimeMax[index]
                                set EC_Speed[EC___i]=EC_Speed[index]
                                set EC_OwnningPlayer[EC___i]=EC_OwnningPlayer[index]
                                set EC_EffectList[EC___i]=EC_EffectList[index]
                                set EC_BrushTrig[EC___i]=EC_BrushTrig[index]
                                set EC_Brush[EC___i]=EC_Brush[index]
                                set EC_BrushTime[EC___i]=EC_BrushTime[index]
                                set EC_BrushDis[EC___i]=EC_BrushDis[index]
                                set EC_PZ[EC___i]=EC_PZ[index]
                                set EC_PZTrig[EC___i]=EC_PZTrig[index]
                                set EC_FlyMode[EC___i]=EC_FlyMode[index]
                                set EC_steeps[EC___i]=EC_steeps[index]
                                set EC_steepsMax[EC___i]=EC_steepsMax[index]
                                set EC_MoveMode[EC___i]=EC_MoveMode[index] //顶部计数-1
                                call SaveInteger(EC_HT, GetHandleId(EC_EffectList[EC___i]), 1000, EC___i)
                                set EC_Index=EC_Index - 1
                                set index=EC_Index - 1
                                if ( index > 0 ) then
                                    set EC___i=EC___i - 1
                                endif
                            else
                                set EC_Index=EC_Index - 1 //在顶部只需要使顶部计数-1 //顶 - 1
                                set index=EC_Index - 1
                            endif
                        endif
                    endif
                endif //
                set EC___i=EC___i + 1
            endloop
        endif
        set u=null
    endfunction
    function EC_EffectChargeDistance takes effect e,real h,real r,real s,real d,player p,trigger dt,trigger ft,real dis returns nothing
        local integer index=EC_Index
        set EC_DisD[index]=0
        set EC_Distance[index]=dis
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=dt
        set EC_FinishTrig[index]=ft
        set EC_OwnningPlayer[index]=p
        set EC_Mode[index]=0
        set EC_Timed[index]=0
        set EC_TimeMax[index]=0
        set EC_PZ[index]=false
        set EC_Brush[index]=false
        set EC_BrushTrig[index]=null
        set EC_BrushTime[index]=0
        set EC_PZTrig[index]=null
        set EC_FlyMode[index]=0
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0
        set EC_MoveMode[index]=0 //
        set EC_Index=EC_Index + 1
    endfunction
