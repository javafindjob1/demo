//===========================================================================
function config takes nothing returns nothing
	call SetMapName("梦想愿境")
	call SetMapDescription("因魔蚀爆发，大部分生物发生变异，正常人类的生活受到重创。冒险者们为解决魔蚀，决定前往魔蚀爆发中心-遗失王都进行调查。")
	call SetPlayers(7)
	call SetTeams(7)
	call SetGamePlacement(MAP_PLACEMENT_TEAMS_TOGETHER)
