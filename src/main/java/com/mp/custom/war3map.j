    function EC_EffectChargeTime takes effect e,real h,real r,real s,real d,player p,trigger dt,trigger ft,real time returns nothing
        local integer index=EC_Index
        set EC_DisD[index]=0
        set EC_Distance[index]=999999
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=dt
        set EC_FinishTrig[index]=ft
        set EC_OwnningPlayer[index]=p
        set EC_Mode[index]=1
        set EC_Timed[index]=0
        set EC_TimeMax[index]=time
        set EC_Brush[index]=false
        set EC_PZ[index]=false
        set EC_PZTrig[index]=null
        set EC_BrushTrig[index]=null
        set EC_BrushTime[index]=0
        set EC_FlyMode[index]=0
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0
        set EC_MoveMode[index]=0 //
        set EC_Index=EC_Index + 1
    endfunction
    function EC_EffectChargeTime2 takes effect e,real h,real r,real s,real d,player p,trigger at,real time,boolean pz,real bruti,boolean brush returns nothing
        local integer index=EC_Index
        set EC_DisD[index]=0
        set EC_Distance[index]=999999
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=at
        set EC_FinishTrig[index]=at
        set EC_PZTrig[index]=at
        set EC_BrushTrig[index]=at
        set EC_OwnningPlayer[index]=p //时间模式
        set EC_Mode[index]=1
        set EC_Timed[index]=0
        set EC_TimeMax[index]=time //是否启用刷新
        set EC_Brush[index]=brush //是否启用碰撞
        set EC_PZ[index]=pz //刷新
        set EC_BrushTime[index]=0
        set EC_BrushDis[index]=bruti //飞行模式
        set EC_FlyMode[index]=0 //移动模式
        set EC_MoveMode[index]=0 //抛物线
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0 //
        set EC_Index=EC_Index + 1
    endfunction  //检查坐标在护盾的范围内 如果非null 则表示在护盾范围内
    function EC_IsInShiled takes real x,real y,player p returns unit
        local integer i2=0
        loop
        exitwhen ( i2 >= EC_ShiledIndex )
            if ( not ( IsUnitAlly(EC_ShiledArray[i2], p) ) ) then //友方护盾则不检查
                if ( X_GDBC(x , y , GetUnitX(EC_ShiledArray[i2]) , GetUnitY(EC_ShiledArray[i2])) <= EC_ShiledSize[i2] ) then
                    return EC_ShiledArray[i2] //返回持有这个护盾的单位
                endif
            endif
            set i2=i2 + 1
        endloop
        return null
    endfunction  //正在冲锋的特效
    function EC_GetChargingEffect takes nothing returns effect
        return EC_TargetEffect
    endfunction  //设置特效飞行模式
    function EC_SetFlyMode takes integer effid,integer modeid,real maxHeight returns nothing
        if ( modeid > 1 ) then
            set modeid=0
        endif
        set EC_FlyMode[effid]=modeid
        set EC_Height[effid]=maxHeight
        if ( EC_Mode[effid] == 0 ) then
            set EC_steepsMax[effid]=R2I(EC_Distance[effid] / EC_Speed[effid]) //BJDebugMsg("Max=" + I2S(EC_steepsMax[effid]));
        else
            set EC_steepsMax[effid]=R2I(EC_TimeMax[effid] / 0.02)
        endif
        set EC_steeps[effid]=0
    endfunction  //被冲锋到的单位
    function EC_GetChargedUnit takes nothing returns unit
        return EC_TargetUnit
    endfunction  //获取被触碰的护盾  仅在护盾触碰回调事件中可用
    function EC_GetShiledUnit takes nothing returns unit
        if ( EC_EventID == 4 ) then
            return EC_TargetUnit
        else
            return null
        endif
    endfunction  //完成冲锋的特效
    function EC_GetFinishingEffect takes nothing returns effect
        return EC_TargetEffect
    endfunction  //是否保护特效 为true则需要手动清除特效
    function EC_KeepEffectALive takes boolean b returns nothing
        set EC_KeepALive=b
    endfunction  //检查是否因为护盾事件结束
    function EC_IsFinishByShiled takes nothing returns boolean
        return EC_ShiledExit
    endfunction  //获得特效在冲锋库中的ID
    function EC_GetEffectId takes nothing returns integer
        return EC___i
    endfunction  //获取正在冲锋的特效所有者
    function EC_GetEffectOwnningPlayer takes nothing returns player
        return EC_EffectOwnningPlayer
    endfunction  //重设结束触发器
    function EC_ReSetEffectFinishTrigger takes integer effid,trigger t returns nothing
        set EC_FinishTrig[effid]=t
    endfunction  //重设刷新触发器
    function EC_ReSetEffectBrushTrigger takes integer effid,trigger t returns nothing
        set EC_BrushTrig[effid]=t
    endfunction  //重设碰撞触发器
    function EC_ReSetEffectDamageTrigger takes integer effid,trigger t returns nothing
        set EC_DamageTrig[effid]=t
    endfunction  //重设撞墙触发器
    function EC_ReSetEffectPZTrigger takes integer effid,trigger t,boolean b returns nothing
        set EC_PZTrig[effid]=t
        set EC_PZ[effid]=b
    endfunction  //重设特效速度
    function EC_ReSetEffectSpeed takes integer effid,real s returns nothing
        set EC_Speed[effid]=s
    endfunction  //重设特效高度
    function EC_ReSetEffectHeight takes integer effid,real s returns nothing
        set EC_Height[effid]=s
    endfunction  //重设特效位移方向
    function EC_ReSetEffectAngle takes integer effid,real s returns nothing
        set EC_D[effid]=s
    endfunction  //重设特效碰撞体积
    function EC_ReSetEffectRange takes integer effid,real s returns nothing
        set EC_Range[effid]=s
    endfunction  //重设特效行程
    function EC_ReSetEffectDistanced takes integer effid,real s returns nothing
        set EC_DisD[effid]=s
    endfunction  //重设特效总行程
    function EC_ReSetEffectMaxDistance takes integer effid,real s returns nothing
        set EC_Distance[effid]=s
    endfunction  //重设特效位移时间
    function EC_ReSetEffectTimed takes integer effid,real s returns nothing
        set EC_Timed[effid]=s
    endfunction  //重设特效位移总时间
    function EC_ReSetEffectMaxTime takes integer effid,real s returns nothing
        set EC_TimeMax[effid]=s
    endfunction  //获取特效的碰撞体积
    function EC_GetEffectRange takes integer effid returns real
        return EC_Range[effid]
    endfunction  //重设特效
    function EC_ReSetEffect takes integer effid,effect e returns nothing
        set EC_EffectList[effid]=e
    endfunction  //获取特效的恒定高度
    function EC_GetEffectHeight takes integer effid returns real
        return EC_Height[effid]
    endfunction  //获取特效的移动速度
    function EC_GetEffectSpeed takes integer effid returns real
        return EC_Speed[effid]
    endfunction  //获取特效的移动方向
    function EC_GetEffectAngle takes integer effid returns real
        return EC_D[effid]
    endfunction  //获取特效的行程
    function EC_GetEffectDisd takes integer effid returns real
        return EC_DisD[effid]
    endfunction  //获取特效的总行程
    function EC_GetEffectMaxDis takes integer effid returns real
        return EC_Distance[effid]
    endfunction  //获取特效的总时间
    function EC_GetEffectMaxTime takes integer effid returns real
        return EC_TimeMax[effid]
    endfunction  //获取特效的位移时间
    function EC_GetEffectTimed takes integer effid returns real
        return EC_Timed[effid]
    endfunction  //获取特效在系统中的ID ， 需要判断非 -1 
    function EC_GetEffectIdOnSystem takes effect e returns integer
        if ( HaveSavedInteger(EC_HT, GetHandleId(e), 1000) ) then
            return LoadInteger(EC_HT, GetHandleId(e), 1000)
        endif
        return - 1
    endfunction  //设置特效启用刷新
    function EC_SetBrush takes integer effid,real dis,boolean b returns nothing
        set EC_Brush[effid]=b
        set EC_BrushDis[effid]=dis
    endfunction  //设置特效移动模式
    function EC_SetMoveMode takes integer effid,integer modeid returns nothing
        if ( modeid != 0 ) then
            set EC_Brush[effid]=true
            set EC_BrushDis[effid]=0.02
        endif
        set EC_MoveMode[effid]=modeid
    endfunction  //获取特效冲锋事件ID
    function EC_GetEVentID takes nothing returns integer
        return EC_EventID
    endfunction  //UI封装 - 转换 特效冲锋事件ID 为 整数
function EC_I2E takes integer l__EC___i returns integer
        return l__EC___i
    endfunction  //UI封装 -空触发器
    function EC_NilTrig takes nothing returns trigger
        return null
    endfunction  //获取顶部计数
    function EC_GetIndex takes nothing returns integer
        return EC_Index - 1
    endfunction  //设置一个护盾
    function EC_SetShiled takes unit s,real size,trigger trig returns nothing
        set EC_ShiledArray[EC_ShiledIndex]=s
        set EC_ShiledSize[EC_ShiledIndex]=size
        set EC_ShiledCallbackTrig[EC_ShiledIndex]=trig
        set EC_ShiledIndex=EC_ShiledIndex + 1
    endfunction  //移除一个护盾
    function EC_RemoveShiled takes unit u returns nothing
        local integer l__EC___i=0
        loop
        exitwhen ( l__EC___i > EC_ShiledIndex )
            if ( EC_ShiledArray[l__EC___i] == u ) then
                set EC_ShiledArray[l__EC___i]=EC_ShiledArray[EC_ShiledIndex] //移除指定的护盾
                set EC_ShiledSize[l__EC___i]=EC_ShiledSize[EC_ShiledIndex]
                set EC_ShiledCallbackTrig[l__EC___i]=EC_ShiledCallbackTrig[EC_ShiledIndex]
                set EC_ShiledIndex=EC_ShiledIndex - 1
                return
            endif
            set l__EC___i=l__EC___i + 1
        endloop
    endfunction  //结束本次冲锋
    function EC_FinishCharge takes nothing returns nothing
        set EC_Exit=true
        if ( EC_EventID == 4 ) then
            set EC_ShiledExit=true
        endif
    endfunction  //设置冲锋由于护盾碰撞而结束
    function EC_FinishChargeByShiled takes nothing returns nothing
        set EC_Exit=true
        set EC_ShiledExit=true
    endfunction  //使弹幕反弹
    function EC_SetEffectRebound takes integer effid returns nothing
        local real x=EXGetEffectX(EC_EffectList[effid])
        local real y=EXGetEffectY(EC_EffectList[effid])
        local real d=360 - EC_GetEffectAngle(effid)
        local real a=x + CosBJ(d) * 31
        local real b=y + SinBJ(d) * 31
        if ( X_IsTerrainWalkable(a , b) ) then
            call EC_ReSetEffectAngle(effid , d)
            call EXEffectMatReset(EC_EffectList[effid])
            call EXEffectMatRotateZ(EC_EffectList[effid], d)
        else
            set d=180 - EC_GetEffectAngle(effid)
            set a=x + CosBJ(d) * 31
            set b=y + SinBJ(d) * 31
            call EC_ReSetEffectAngle(effid , d)
            call EXEffectMatReset(EC_EffectList[effid])
            call EXEffectMatRotateZ(EC_EffectList[effid], d)
        endif
    endfunction  //新建闪电效果
    function EC_AddLighting takes string s,boolean bo,real x,real y,real a,real b returns lightning
        return AddLightning(s, bo, x, y, a, b)
    endfunction  //获取单位的range范围内的随机点
    function GetRandomLocNearUnit takes unit u,real range returns location
        local real sd=GetRandomReal(0, range)
        local real d=GetRandomReal(0, 360)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        return Location(x + CosBJ(d) * sd, y + SinBJ(d) * sd)
    endfunction  //获取与单位在min~max距离之间的随机点
    function GetRandomLocBetween takes unit u,real min,real max returns location
        local real sd=GetRandomReal(min, max)
        local real d=GetRandomReal(0, 360)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        return Location(x + CosBJ(d) * sd, y + SinBJ(d) * sd)
    endfunction  //命令特效e 开始冲锋， 保持相对地面高度为 h 碰撞范围 r 冲锋速度 s 伤害来源单位为 u 伤害值为 damage 冲锋距离 dis 检查碰撞 b 是否穿透单位 b2
    function EC_Charger takes effect e,real h,real r,real s,real d,unit u,real damage,real dis,boolean b,boolean b2 returns nothing
        local integer index=EC_Index
        if ( e == null ) then
            return
        endif //基本数据
        set EC_DisD[index]=0
        set EC_Distance[index]=dis
        set EC_EffectList[index]=e
        set EC_Height[index]=h
        set EC_Range[index]=r
        set EC_Speed[index]=s
        set EC_D[index]=d
        set EC_DamageTrig[index]=EC_TRIG
        set EC_FinishTrig[index]=EC_TRIG
        set EC_PZTrig[index]=EC_TRIG
        set EC_BrushTrig[index]=EC_TRIG
        set EC_PZTrig[index]=EC_TRIG
        set EC_OwnningPlayer[index]=GetOwningPlayer(u)
        set EC_Mode[index]=0
        set EC_Timed[index]=0
        set EC_TimeMax[index]=0
        set EC_PZ[index]=b
        set EC_Brush[index]=false
        set EC_BrushTime[index]=1
        set EC_FlyMode[index]=0
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0
        set EC_MoveMode[index]=0
        set EC_Index=EC_Index + 1 //保存附加数据  --伤害来源u 伤害值damage
        call SaveReal(EC_HT, GetHandleId(e), EC_K_Damage, damage) //--伤害值 //--伤害来源
        call SaveUnitHandle(EC_HT, GetHandleId(e), EC_K_Unit, u) //--保护组
        call SaveGroupHandle(EC_HT, GetHandleId(e), EC_K_Group, CreateGroup()) //--是否穿透
        call SaveBoolean(EC_HT, GetHandleId(e), EC_K_Penetrate, b2)
    endfunction
    function EC___EC_TRIGEVT takes nothing returns nothing
        local effect e=EC_TargetEffect
        local player p=EC_EffectOwnningPlayer
        local integer id=EC_EventID
        local real a
        local real b
        local unit u
        local real damage
        local string str
        local boolean IsPenetrate=LoadBoolean(EC_HT, GetHandleId(e), EC_K_Penetrate)
        set u=LoadUnitHandle(EC_HT, GetHandleId(e), EC_K_Unit)
        set damage=LoadReal(EC_HT, GetHandleId(e), EC_K_Damage)
        set EC_group=LoadGroupHandle(EC_HT, GetHandleId(e), EC_K_Group) //固定流程：对被冲锋的敌人造成伤害一次
        if ( id == 0 ) then
            if ( IsUnitEnemy(EC_GetChargedUnit(), EC_GetEffectOwnningPlayer()) ) then //碰撞 //是敌人
                if ( IsUnitAliveBJ(EC_GetChargedUnit()) ) then //非死亡单位
                    if ( not ( IsUnitInGroup(EC_GetChargedUnit(), EC_group) ) ) then //不在单位组中
                        call UnitDamageTarget(u, EC_GetChargedUnit(), damage, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS) //造成伤害,添加到单位组
                        call GroupAddUnit(EC_group, EC_GetChargedUnit())
                        if ( not IsPenetrate ) then
                            call EC_FinishCharge() //不穿透就停止冲锋
                        endif
                    endif
                endif
            endif
        elseif ( id == 1 ) then
            call DestroyGroup(EC_group) //结束  //清除单位组，特效，哈希表数据
            call DestroyEffect(e)
            call FlushChildHashtable(EC_HT, GetHandleId(e))
        elseif ( id == 2 ) then
            if ( HaveSavedString(EC_HT, GetHandleId(e), EC_K_Brush) ) then
                set a=EXGetEffectX(e)
                set b=EXGetEffectY(e)
                set EC_2_ID=EC_GetEffectIdOnSystem(e)
                if ( EC_2_ID != - 1 ) then
                    set str=LoadStr(EC_HT, GetHandleId(e), EC_K_Brush)
                    call EC_DestroyEffect(e)
                    call FlushChildHashtable(EC_HT, GetHandleId(e))
                    set e=AddSpecialEffect(str, a, b) //--伤害值
                    call SaveReal(EC_HT, GetHandleId(e), EC_K_Damage, damage) //--伤害来源
                    call SaveUnitHandle(EC_HT, GetHandleId(e), EC_K_Unit, u) //--保护组
                    call SaveGroupHandle(EC_HT, GetHandleId(e), EC_K_Group, EC_group) //--是否穿透
                    call SaveBoolean(EC_HT, GetHandleId(e), EC_K_Penetrate, IsPenetrate)
                    call SaveStr(EC_HT, GetHandleId(e), EC_K_Brush, str)
                    call EC_ReSetEffect(EC_2_ID , e)
                endif
            endif
        elseif ( id == 3 ) then
            call EC_SetEffectRebound(EC_GetEffectId()) //撞墙
        endif
        set e=null
        set p=null
        set u=null
        set EC_group=null
    endfunction  //固定流程特效
    //public:
    function EC___EC_TriggerInit takes nothing returns nothing
        set EC_TRIG=CreateTrigger()
        call TriggerAddAction(EC_TRIG, function EC___EC_TRIGEVT)
    endfunction
    //public:
    function EC___EC_SE1 takes nothing returns nothing
        local integer l__EC___i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local unit u
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT, GetHandleId(t), 1)
        set b=LoadReal(EC_HT, GetHandleId(t), 2)
        set speed=LoadReal(EC_HT, GetHandleId(t), 3)
        set bbb=LoadReal(EC_HT, GetHandleId(t), 4)
        set u=LoadUnitHandle(EC_HT, GetHandleId(t), 5)
        set tu=LoadUnitHandle(EC_HT, GetHandleId(t), 6)
        set trig=LoadTriggerHandle(EC_HT, GetHandleId(t), 7)
        set id=LoadInteger(EC_HT, GetHandleId(t), 8) //-------------
        set x1=GetUnitX(u)
        set y1=GetUnitY(u)
        set x=GetUnitX(tu)
        set y=GetUnitY(tu)
        set d=X_GAFC(a , b , x , y)
        set dis=X_GDBC(a , b , x , y) //初步计算预瞄点
        set s=dis * bbb //低精度预瞄点(x2,y2)
        set x2=x + CosBJ(d) * s
        set y2=y + SinBJ(d) * s //精度控制
        set l__EC___i=R2I(bbb) / 100
        set l__EC___i=l__EC___i + 3 //重算——推演出着弹点
        loop
        exitwhen ( l__EC___i <= lpi )
            set lpi=lpi + 1
            set dis2=X_GDBC(x1 , y1 , x2 , y2)
            set bbb=( dis2 / speed ) * 100
            set s=dis * bbb
            set x2=x + CosBJ(d) * s
            set y2=y + SinBJ(d) * s
        endloop //回调
        set EC_CB_angle=X_GAFC(x1 , y1 , x2 , y2)
        set EC_CB_Unit=u
        set EC_CB_TargetUnit=tu
        set EC_CB_ID=id
        if ( TriggerEvaluate(trig) ) then
            call TriggerExecute(trig)
        endif //清理
        call FlushChildHashtable(EC_HT, GetHandleId(t))
        call DestroyTimer(t) //
        set t=null
        set u=null
        set tu=null
        set trig=null
    endfunction
    function EC___EC_SE2 takes nothing returns nothing
        local integer l__EC___i=0
        local integer lpi=0
        local integer id=0
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real y1
        local real y2
        local real dis
        local real speed
        local real d
        local real bbb
        local real s
        local real dis2
        local effect e
        local unit tu
        local trigger trig
        local timer t=GetExpiredTimer()
        set a=LoadReal(EC_HT, GetHandleId(t), 1)
        set b=LoadReal(EC_HT, GetHandleId(t), 2)
        set speed=LoadReal(EC_HT, GetHandleId(t), 3)
        set bbb=LoadReal(EC_HT, GetHandleId(t), 4)
        set e=LoadEffectHandle(EC_HT, GetHandleId(t), 5)
        set tu=LoadUnitHandle(EC_HT, GetHandleId(t), 6)
        set trig=LoadTriggerHandle(EC_HT, GetHandleId(t), 7)
        set id=LoadInteger(EC_HT, GetHandleId(t), 8) //-------------
        set x1=EXGetEffectX(e)
        set y1=EXGetEffectY(e)
        set x=GetUnitX(tu)
        set y=GetUnitY(tu)
        set d=X_GAFC(a , b , x , y)
        set dis=X_GDBC(a , b , x , y) //初步计算预瞄点
        set s=dis * bbb //低精度预瞄点(x2,y2)
        set x2=x + CosBJ(d) * s
        set y2=y + SinBJ(d) * s //精度控制
        set l__EC___i=R2I(bbb) / 100
        set l__EC___i=l__EC___i + 3 //重算——推演出着弹点
        loop
        exitwhen ( l__EC___i <= lpi )
            set lpi=lpi + 1
            set dis2=X_GDBC(x1 , y1 , x2 , y2)
            set bbb=( dis2 / speed ) * 100
            set s=dis * bbb
            set x2=x + CosBJ(d) * s
            set y2=y + SinBJ(d) * s
        endloop //回调
        set EC_CB_angle=X_GAFC(x1 , y1 , x2 , y2)
        set EC_CB_Effect=e
        set EC_CB_TargetUnit=tu
        set EC_CB_ID=id
        if ( TriggerEvaluate(trig) ) then
            call TriggerExecute(trig)
        endif //清理
        call FlushChildHashtable(EC_HT, GetHandleId(t))
        call DestroyTimer(t) //
        set t=null
        set e=null
        set tu=null
        set trig=null
    endfunction
    function EC_GetGroup takes real x,real y,real j,real d,real r returns group
        local group l__EC___g=CreateGroup()
        local unit u
        local real x1
        local real y1
        local real d1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(l__EC___g, x, y, r, null)
        set u=FirstOfGroup(l__EC___g)
        loop
        exitwhen ( u == null )
            set x1=GetUnitX(u)
            set y1=GetUnitY(u)
            set d1=Atan2(y1 - y, x1 - x) * 180 / bj_PI
            if ( d1 < 0 ) then
                set d1=360 + d1
            endif
            if ( d1 > d - j / 2 and d1 < d + j / 2 ) then
                call GroupAddUnit(bj_lastCreatedGroup, u)
            endif
            call GroupRemoveUnit(l__EC___g, u)
            set u=FirstOfGroup(l__EC___g)
        endloop
        call DestroyGroup(l__EC___g)
        set l__EC___g=null
        set u=null
        return bj_lastCreatedGroup
    endfunction
    function EC_ShootReady takes unit u,real speed,unit tu,trigger callBack,integer id returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t=CreateTimer()
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x , y , a , b)
        set bbb=( dis / speed ) * 100 //保存单位当前位置
        call SaveReal(EC_HT, GetHandleId(t), 1, a)
        call SaveReal(EC_HT, GetHandleId(t), 2, b)
        call SaveReal(EC_HT, GetHandleId(t), 3, speed)
        call SaveReal(EC_HT, GetHandleId(t), 4, bbb)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 5, u)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 6, tu)
        call SaveTriggerHandle(EC_HT, GetHandleId(t), 7, callBack)
        call SaveInteger(EC_HT, GetHandleId(t), 8, id) //运行计算
        call TimerStart(t, 0.01, false, function EC___EC_SE1)
        set t=null
    endfunction
    function EC_ShootReady_Effect takes effect e,real speed,unit tu,trigger callBack,integer id returns nothing
        local real x
        local real y
        local real a
        local real b
        local real x1
        local real x2
        local real dis
        local real d
        local real bbb
        local timer t=CreateTimer()
        set x=EXGetEffectX(e)
        set y=EXGetEffectY(e)
        set a=GetUnitX(tu)
        set b=GetUnitY(tu)
        set dis=X_GDBC(x , y , a , b)
        set bbb=( dis / speed ) * 100 //保存单位当前位置
        call SaveReal(EC_HT, GetHandleId(t), 1, a)
        call SaveReal(EC_HT, GetHandleId(t), 2, b)
        call SaveReal(EC_HT, GetHandleId(t), 3, speed)
        call SaveReal(EC_HT, GetHandleId(t), 4, bbb)
        call SaveEffectHandle(EC_HT, GetHandleId(t), 5, e)
        call SaveUnitHandle(EC_HT, GetHandleId(t), 6, tu)
        call SaveTriggerHandle(EC_HT, GetHandleId(t), 7, callBack)
        call SaveInteger(EC_HT, GetHandleId(t), 8, id) //运行计算
        call TimerStart(t, 0.01, false, function EC___EC_SE2)
        set t=null
    endfunction  //获取回调事件ID
    function GetCallBackID takes nothing returns integer
        return EC_CB_ID
    endfunction  //获取回调发射角度
    function GetCallBackAngle takes nothing returns real
        return EC_CB_angle
    endfunction  //获取回调源单位
    function GetCallBackUnit takes nothing returns unit
        return EC_CB_Unit
    endfunction  //获取回调源特效
    function GetCallBackEffect takes nothing returns effect
        return EC_CB_Effect
    endfunction  //获取回调目标单位
    function GetCallBackTargetUnit takes nothing returns unit
        return EC_CB_TargetUnit
    endfunction  //初始化
    function EC___onInit takes nothing returns nothing
        set EC_Timer=CreateTimer()
        set EC_HT=InitHashtable()
        call EC___EC_TriggerInit()
        call TimerStart(EC_Timer, 0.02, true, function EC___EC_TimerEvent)
    endfunction

