//library Fbase:
//单位到坐标距离
function FUnitDisBtwCoords takes unit u,real x,real y returns real
    return SquareRoot(Pow(GetUnitX(u) - x, 2) + Pow(GetUnitY(u) - y, 2))
endfunction
//两坐标间距离
function FDisBtwCoords takes real x1,real y1,real x2,real y2 returns real
    return SquareRoot(Pow(x1 - x2, 2) + Pow(y1 - y2, 2))
endfunction
//两坐标间距离的平方
function FDisSqrBtwCoords takes real x1,real y1,real x2,real y2 returns real
    return Pow(x1 - x2, 2) + Pow(y1 - y2, 2)
endfunction
//坐标到直线的距离
function FDisBtwCoordNLine takes real x1,real y1,real x2,real y2,real x3,real y3 returns real
    return RAbsBJ(( x1 - x3 ) * ( y2 - y1 ) - ( x1 - x2 ) * ( y3 - y1 )) / SquareRoot(( y3 - y2 ) * ( y3 - y2 ) + ( x3 - x2 ) * ( x3 - x2 ))
endfunction
//两坐标间方向
function FAngleBtwCoords takes real x1,real y1,real x2,real y2 returns real
    return bj_RADTODEG * Atan2(y2 - y1, x2 - x1)
endfunction
//两单位距离
function FUnitDistance takes unit u,unit u0 returns real
	return FDisBtwCoords(GetUnitX(u) , GetUnitY(u) , GetUnitX(u0) , GetUnitY(u0))
endfunction
//添加技能并设永久
function Faddabilityp takes unit u,integer l,integer a,boolean b,boolean bf returns nothing
    if ( bf ) then
        call SetPlayerAbilityAvailable(GetOwningPlayer(u), a, false)
    endif
    call UnitAddAbility(u, a)
    call UnitMakeAbilityPermanent(u, b, a)
    call SetUnitAbilityLevel(u, a, l)
endfunction
	//设置单位坐标
 function FSetUnitXY takes unit u,real Howx,real Howy returns nothing
  local real x= Howx
  local real y= Howy
    	if IsTerrainPathable(x, y, PATHING_TYPE_ANY) == true then
    		if x < GetRectMinX(GetWorldBounds()) then
    			set x=GetRectMinX(GetWorldBounds())
    		elseif x > GetRectMaxX(GetWorldBounds()) then
    			set x=GetRectMaxX(GetWorldBounds())
    		endif
    		if y < GetRectMinY(GetWorldBounds()) then
    			set y=GetRectMinY(GetWorldBounds())
    		elseif y > GetRectMaxY(GetWorldBounds()) then
    			set y=GetRectMaxY(GetWorldBounds())
    		endif
        	call SetUnitX(u, x)
        	call SetUnitY(u, y)
    	endif
	endfunction
	//位移单位(角度)
 function FMoveUnitForAngle takes unit WhichUnit,real an,real skpu returns nothing
     local unit u= WhichUnit
     local real x= GetUnitX(u) + CosBJ(an) * skpu
     local real y= GetUnitY(u) + SinBJ(an) * skpu
    	if ( x > GetRectMaxX(GetWorldBounds()) ) then
        	set x=GetRectMaxX(GetWorldBounds())
    	endif
    	if ( x < GetRectMinX(GetWorldBounds()) ) then
        	set x=GetRectMinX(GetWorldBounds())
    	endif
    	if ( y > GetRectMaxY(GetWorldBounds()) ) then
        	set y=GetRectMaxY(GetWorldBounds())
    	endif
   		if ( y < GetRectMinY(GetWorldBounds()) ) then
        	set y=GetRectMinY(GetWorldBounds())
    	endif
    	call SetUnitX(u, x)
    	call SetUnitY(u, y)
    	set u=null
	endfunction
	//位移点(角度)
 function FMoveLocForAngle takes location WhichLoc,real skpu,real an returns nothing
     local location l= WhichLoc
     local real x= GetLocationX(l) + CosBJ(an) * skpu
     local real y= GetLocationY(l) + SinBJ(an) * skpu
    	if ( x > GetRectMaxX(GetWorldBounds()) ) then
        	set x=GetRectMaxX(GetWorldBounds())
    	endif
    	if ( x < GetRectMinX(GetWorldBounds()) ) then
        	set x=GetRectMinX(GetWorldBounds())
    	endif
    	if ( y > GetRectMaxY(GetWorldBounds()) ) then
        	set y=GetRectMaxY(GetWorldBounds())
    	endif
    	if ( y < GetRectMinY(GetWorldBounds()) ) then
        	set y=GetRectMinY(GetWorldBounds())
    	endif
    	call MoveLocation(l, x, y)
    	set l=null
	endfunction
	//显示特效
	//不能显示延时特效
 function FShowEffect takes string tx,real x,real y returns nothing
    	call DestroyEffect(AddSpecialEffect(tx, x, y))
	endfunction

//library Fbase ends
//library StarPolledWaitNull:
    function StarPolledWaitNull takes real duration returns nothing
        local timer t
        local real timeRemaining
    
        if ( duration > 0 ) then
            set t=CreateTimer()
            call TimerStart(t, duration, false, null)
            loop
                set timeRemaining=TimerGetRemaining(t)
                if StarMsg_IsEsc then
                    exitwhen timeRemaining <= duration * StarMsg_SkipValue
                else
                    exitwhen timeRemaining <= 0
                endif
                if ( timeRemaining > bj_POLLED_WAIT_SKIP_THRESHOLD ) then //如果剩余时间>2秒
call TriggerSleepAction(0.1 * timeRemaining) // 假设
else
                    call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL) // 否则等待0.1
endif
            endloop
            call DestroyTimer(t)
        endif
        set t=null
    endfunction
    

