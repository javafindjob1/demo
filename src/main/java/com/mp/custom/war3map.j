	endif
	set ydul_i=1
	loop
		exitwhen ydul_i > 5
		if ( ( GetPlayerSlotState(ConvertedPlayer(ydul_i)) == PLAYER_SLOT_STATE_PLAYING ) and ( GetPlayerController(ConvertedPlayer(ydul_i)) == MAP_CONTROL_USER ) ) then
