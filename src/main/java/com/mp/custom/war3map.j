function main takes nothing returns nothing
	call SetCameraBounds(- 29952.000000 + GetCameraMargin(CAMERA_MARGIN_LEFT), - 30208.000000 + GetCameraMargin(CAMERA_MARGIN_BOTTOM), 20864.000000 - GetCameraMargin(CAMERA_MARGIN_RIGHT), 26368.000000 - GetCameraMargin(CAMERA_MARGIN_TOP), - 29952.000000 + GetCameraMargin(CAMERA_MARGIN_LEFT), 26368.000000 - GetCameraMargin(CAMERA_MARGIN_TOP), 20864.000000 - GetCameraMargin(CAMERA_MARGIN_RIGHT), - 30208.000000 + GetCameraMargin(CAMERA_MARGIN_BOTTOM))
	call SetDayNightModels("Environment\\DNC\\DNCAshenvale\\DNCAshenvaleTerrain\\DNCAshenvaleTerrain.mdl", "Environment\\DNC\\DNCAshenvale\\DNCAshenvaleUnit\\DNCAshenvaleUnit.mdl")
	call SetTerrainFogEx(0, 5000.00, 15000.00, 1.000, 0.000, 0.000, 0.000)
	call NewSoundEnvironment("Default")
	call SetAmbientDaySound("AshenvaleDay")
	call SetAmbientNightSound("AshenvaleNight")
	call SetMapMusic("Music", true, 0)
	call InitSounds()
	call InitRandomGroups()
	call CreateRegions()
	call CreateCameras()
	call CreateDestructables()
	call CreateItems()
	call CreateUnits()
	call InitBlizzard()

call ExecuteFunc("jasshelper__initstructs1509725875")
call ExecuteFunc("X___Init")
call ExecuteFunc("YDTriggerSaveLoadSystem___Init")
call ExecuteFunc("InitializeYD")
call ExecuteFunc("EC___onInit")
call ExecuteFunc("StarMsg___onInit")
call ExecuteFunc("YDWEStringFormula___Init")
call ExecuteFunc("YDWETimerSystem___Init")

	call InitGlobals()
	call InitCustomTriggers()
	call RunInitializationTriggers()
endfunction
