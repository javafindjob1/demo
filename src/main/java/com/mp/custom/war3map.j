function Trig_306_B___________________1_____________uConditions takes nothing returns boolean
	return ( ( GetSpellAbilityId() == 'A0C9' ) )
endfunction
function Trig_306_B___________________1_____________uFunc010T takes nothing returns nothing
 local group ydl_group
 local unit ydl_unit
	if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x2970F80D) == 0 ) ) then
		call SetUnitAnimation(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), "Attack 1")
	else
		call DoNothing()
	endif
	if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x2970F80D) == 70 ) ) then
		call SetUnitAnimation(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), "Attack 1")
	else
		call DoNothing()
	endif
	if ( ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x2970F80D) <= LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x54F604AE) ) ) then
		call SaveInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x2970F80D, ( LoadInteger(YDLOC, GetHandleId(GetExpiredTimer()), 0x2970F80D) + 1 ))
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x72C71CBD, ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x72C71CBD) + ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x7D2C6D83) * CosBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)) ) ))
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x844A4D3D, ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x844A4D3D) + ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x7D2C6D83) * SinBJ(LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xB9A583B8)) ) ))
		//位移坐标
		call SetUnitX(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x72C71CBD))
		call SetUnitY(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x844A4D3D))
		//高度坐标
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9F0C6E00, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9F0C6E00) ) + ( ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x38344552) ) * ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x12CDC6CC) ) ) ) ))
		call SaveReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x38344552, ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x38344552) ) - ( ( ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0xA1614B4D) ) * ( LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x12CDC6CC) ) ) ) ))
		call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x9F0C6E00), 0.00)
	else
		call SetUnitFlyHeight(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), 0.00, 0.00)
		call YDWEUnitRemoveStun(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615))
		call SetUnitInvulnerable(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), false)
		call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl", LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x72C71CBD), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x844A4D3D)))
		set ydl_group=CreateGroup()
		call GroupEnumUnitsInRange(ydl_group, LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x72C71CBD), LoadReal(YDLOC, GetHandleId(GetExpiredTimer()), 0x844A4D3D), 300.00, null)
		loop
			set ydl_unit=FirstOfGroup(ydl_group)
			exitwhen ydl_unit == null
			call GroupRemoveUnit(ydl_group, ydl_unit)
			if ( ( GetUnitState(ydl_unit, UNIT_STATE_LIFE) >= 1.00 ) and ( IsUnitEnemy(ydl_unit, GetOwningPlayer(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615))) == true ) ) then
				call UnitDamageTarget(LoadUnitHandle(YDLOC, GetHandleId(GetExpiredTimer()), 0xB06AB615), ydl_unit, ( 20000.00 + ( 3000.00 * I2R(udg_Degree) ) ), false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE, WEAPON_TYPE_WHOKNOWS)
			else
			endif
		endloop
		call DestroyGroup(ydl_group)
		call FlushChildHashtable(YDLOC, GetHandleId(GetExpiredTimer()))
		call DestroyTimer(GetExpiredTimer())
	endif
	set ydl_group=null
	set ydl_unit=null
endfunction
