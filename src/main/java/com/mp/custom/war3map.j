	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xEA59A379)) ) + ( ( ( "：" ) + ( "|r" ) + ( "山谷里面地形复杂，怪物又多，还长有奇怪的剧毒蘑菇，根本不是我用隐身粉尘就能够跑过去的......各位是冒险者吗？" ) ) ) ) , 4.00)
