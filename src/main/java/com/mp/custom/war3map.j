		call SaveItemHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D, CreateItem('ssan', LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xA99320FA), LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xFDF65382)))
		call DestroyTrigger(gg_trg_RE3_10_________________________________________510)
		call DestroyTrigger(gg_trg_RE3_11_________________________________________511)
		call QuestSetDiscovered(udg_MissB[24], true)
		set udg_MissB_Renwu[704]=CreateQuestItemBJ(udg_MissB[24], "附近的地形并无异常。")
		call QuestItemSetCompleted(udg_MissB_Renwu[704], true)
		call QuestSetCompleted(udg_MissB[24], true)
	endif
	set ydul_i=1
	loop
		exitwhen ydul_i > 5
		if ( ( GetPlayerSlotState(ConvertedPlayer(ydul_i)) == PLAYER_SLOT_STATE_PLAYING ) and ( GetPlayerController(ConvertedPlayer(ydul_i)) == MAP_CONTROL_USER ) ) then
