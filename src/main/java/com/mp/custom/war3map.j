//===========================================================================
// Trigger: 4-+[灵核-受伤提高]
//自定义jass生成器 作者：007 
//有bug到魔兽地图编辑器吧 @w4454962 
//bug反馈群：724829943   lua 技术交流3群：710331384
//===========================================================================
function Trig_4_______________________uConditions takes nothing returns boolean
	return ( ( GetEventDamage() >= 2.00 ) ) and ( ( YDWEIsEventAttackDamage() == true ) ) and ( ( YDWEIsEventPhysicalDamage() == true ) ) and ( ( ( GetUnitAbilityLevel(GetTriggerUnit(), 'A0ZX') > 0 ) or ( GetUnitAbilityLevel(GetTriggerUnit(), 'A105') > 0 ) or ( GetUnitAbilityLevel(GetTriggerUnit(), 'A105') > 0 ) ) )
endfunction
function Trig_4_______________________uActions takes nothing returns nothing
 local integer ydl_localvar_step= LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76)
 set ydl_localvar_step=ydl_localvar_step + 1
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xCFDE6C76, ydl_localvar_step)
 call SaveInteger(YDLOC, GetHandleId(GetTriggeringTrigger()), 0xECE825E7, ydl_localvar_step)
	call DisableTrigger(GetTriggeringTrigger())
	call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xB06AB615, GetTriggerUnit())
	call SaveUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x18B77D11, GetEventDamageSource())
	call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1, 0.00)
	if ( ( GetUnitAbilityLevel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xB06AB615), 'A0ZX') > 0 ) ) then
		call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1, ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1) + 0.02 ))
	else
	endif
	if ( ( GetUnitAbilityLevel(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xB06AB615), 'A105') > 0 ) ) then
		call SaveReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1, ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1) + 0.02 ))
	else
	endif
	//物理伤害减免最终结算
	if ( ( LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1) > 0.00 ) ) then
		call YDWESetEventDamage(( GetEventDamage() * ( 1.00 + LoadReal(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x25F62AE1) ) ))
	else
	endif
	call EnableTrigger(GetTriggeringTrigger())
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000)
endfunction
