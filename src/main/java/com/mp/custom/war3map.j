	set udg_MissB[3]=CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, ( "|cffbeedc7木材收藏家|r  " ), "每个人都有自己独特的爱好，遗失王都的马利也是如此。对马利来说，没有比欣赏木材的纹理更开心的事情了。", "ReplaceableTextures\\CommandButtons\\BTNNaturesBlessing.blp")
