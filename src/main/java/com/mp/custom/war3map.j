	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "我曾经在城堡里见过几次莉亚，她应该也是旧王都的魔法师吧。" ) ) ) ) , 3.50)
