			call DzAPI_Map_Stat_SetStat(ConvertedPlayer(ydul_i), "MXLCD", I2S(udg_MXLCD[ydul_i]))
			call DisplayTimedTextToPlayer(ConvertedPlayer(ydul_i), 0, 0, 8.00, ( ( "|cffff00ff梦想里程点 + " ) + ( I2S(LoadInteger(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x64C21348)) ) + ( "|r" ) ))
		else
		endif
		set ydul_i=ydul_i + 1
	endloop
	call DestroyTrigger(gg_trg_RE11_3_________________________________u)
	call DestroyTrigger(gg_trg_RE11_4_____________________________________u)
	call DestroyTrigger(gg_trg_RE11_5__________________________________u)
	call DestroyTrigger(gg_trg_RE11_6_______________________________1___u)
	call DestroyTrigger(gg_trg_RE11_7_______________________________2___u)
	call DestroyTrigger(gg_trg_RE11_8_______________________________3___u)
