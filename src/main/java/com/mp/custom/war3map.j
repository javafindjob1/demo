	call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "", gg_snd_DYYX_1, "|cffbee7e9这里本是一个和平而美丽的世界，没有战争和冲突，人们和谐相处，互相尊重彼此的文化和信仰。绿树成荫，河流清澈，野生动物在没有威胁的环境中自由生活。", bj_TIMETYPE_SET, 17.00, true)
