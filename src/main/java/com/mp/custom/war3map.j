        set EC_DamageTrig[index]=dt
        set EC_FinishTrig[index]=dt
        set EC_PZTrig[index]=dt
        set EC_OwnningPlayer[index]=p
        set EC_Mode[index]=0
        set EC_Timed[index]=0
        set EC_TimeMax[index]=0
        set EC_PZ[index]=b
        set EC_Brush[index]=false
        set EC_BrushTrig[index]=null
        set EC_BrushTime[index]=0
        set EC_PZTrig[index]=null
        set EC_FlyMode[index]=0
        set EC_steepsMax[index]=0
        set EC_steeps[index]=0
        set EC_MoveMode[index]=0 //
