	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "我曾是旧王都皇女大人|cfff4606c爱尔莎|r的侍卫，负责保护皇女大人平时的安全。" ) ) ) ) , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "皇女大人身处王位，时刻在为子民们努力。平时不仅勤工勤政，同时也不断地与大魔法师费伦钻研魔法的运用，以造福子民们。" ) ) ) ) , 6.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "但是那一天，我护送皇女大人到魔法工坊后，没过多久忽然感受到工坊里传来攻击魔法的波动。" ) ) ) ) , 5.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "我冲了进去，看到费伦正在吟唱攻击魔法，想要攻击皇女大人。我没有多想，挡到了皇女面前，被攻击魔法直接命中，昏了过去。" ) ) ) ) , 6.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "当我醒来时，已经身处城堡外侧。奇怪的是我竟然浑身上下一点伤没有，而且主城的居住区上笼罩着像是费伦施放的防御魔法，城堡也被封印魔法封住。" ) ) ) ) , 7.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "后来才听说就是那天爆发了能使动物异变的魔蚀。" ) ) ) ) , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "由于王都群龙无首，很多士兵都为了躲避灾难去了自己认为安全的地方。" ) ) ) ) , 4.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "而我坚信皇女大人现在还活着，当时应该是她救了我！以她的魔法即使被封印在城堡里也不会撑不下去。" ) ) ) ) , 5.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "这些年我四处募集勇士，创建了银腕兵团，并且回到王都遗迹在此维和，为的就是重振王都，救出皇女大人!" ) ) ) ) , 5.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "听说各位徒步来到王都遗迹，应该具有相当的实力，如果可以的话还请各位能够帮忙调查破除封印，进入城堡的方法。" ) ) ) ) , 6.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x6459A368)) ) + ( ( ( "：" ) + ( "|r" ) + ( "想必进去之后自然也会有解决魔蚀的办法！" ) ) ) ) , 2.50)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffff00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0x7B62A7B5)) ) + ( ( ( "：" ) + ( "|r" ) + ( "......" ) ) ) ) , 1.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 8.00 , ( ( "|cffffcc00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D)) ) + ( ( ( "：" ) + ( "|r" ) + ( "（原来是这样，但是还有很多细节问题不明确）..." ) ) ) ) , 2.00)
