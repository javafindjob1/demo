	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "我相信你已经帮他们解脱了。" , 3.50)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "既然你能够拿到暗紫晶体，就说明你有能力帮我实现我的夙愿。" , 4.50)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 13.00 , "其实在修复战衣时，我特意加入了可以与亡灵产生短暂共鸣的物质。不好意思，可能本质上来说我还是利用了你。" , 6.50)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 15.00 , "我的冒险伙伴们曾经是最勇敢的战士，我们相互陪伴了整整八年。但是却在那时不幸遇到了死神和魔蚀爆发的双重危机。" , 7.50)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 13.00 , "在那种场面下，我害怕了。他们每个人都在让我逃跑。" , 4.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 15.00 , "而我也做了人生中最悔恨的决定。在他们的掩护下，我确实成功的逃离了那里，慌张地在远处看着昔日最亲密的伙伴被亡之气息吞噬。" , 8.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "在这五年里，我无时无刻不在为那种行为忏悔。" , 4.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "但是，这毫无意义。" , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 14.00 , "我用冒险团剩下的大部分资源，购换了锚定在死神领域的传送卷轴，正是希望能有像你一样的英雄来拯救我。" , 7.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 14.00 , "拯救被束缚住灵魂的我的伙伴。" , 4.50)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "现在，我没有遗憾了。我该去他们都在的那个地方了。" , 5.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "随信还有一块我们冒险团曾经碰巧取得的灵子块，相信你可以用上。" , 5.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "世界需要像你这样的英雄。" , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , "永别了，我的朋友。" , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , ( ( "|cffffcc00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D)) ) + ( ( ( "：" ) + ( "|r" ) + ( "瑞莫斯...唉..." ) ) ) ) , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , ( ( "|cffffcc00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D)) ) + ( ( ( "：" ) + ( "|r" ) + ( "（实际上只帮其中两位解脱了，剩下的七位到底去哪里了...）" ) ) ) ) , 5.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , ( ( "|cffffcc00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D)) ) + ( ( ( "：" ) + ( "|r" ) + ( "现在瑞莫斯可能也凶多吉少了...但是眼前还是要以解决魔蚀为最优先的项目。" ) ) ) ) , 6.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , ( ( "|cffffcc00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D)) ) + ( ( ( "：" ) + ( "|r" ) + ( "只能先放置这件事了。" ) ) ) ) , 3.00)
	call StarMsg_DisplayTimedTextToForce(udg_WANJIA , 10.00 , ( ( "|cffffcc00" ) + ( GetUnitName(LoadUnitHandle(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000, 0xC303079D)) ) + ( ( ( "：" ) + ( "|r" ) + ( "（瑞莫斯，我一定会帮你完成你的夙愿的。）" ) ) ) ) , 4.00)
	call FlushChildHashtable(YDLOC, GetHandleId(GetTriggeringTrigger()) + ydl_localvar_step * 0x80000)
	set ydl_timer=null
endfunction
