	set udg_MissB[6]=CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, ( "|cffecad9e动乱|r  " ), "解除城堡的魔法结界后，周围传来了怪物的怒吼......", "ReplaceableTextures\\CommandButtons\\BTNInfernal.blp")
