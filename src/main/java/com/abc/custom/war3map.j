return 0
endif
set VD[U4]=-1
return U4
endfunction
function BG4 takes integer U4 returns nothing
if U4==null then
return
elseif VD[U4]!=-1 then
return
endif
set VD[U4]=VE
set VE=U4
endfunction
function BG6 takes nothing returns integer
local integer U4=bQ
if U4!=0 then
set bQ=bR[U4]
else
set bS=bS+1
set U4=bS
endif
if U4>1022 then
return 0
endif
set VV[U4]=(U4-1)*8
set VX[U4]=(U4-1)*8
set bT[U4]=7
set bR[U4]=-1
return U4
endfunction
function BG8 takes nothing returns integer
local integer U4=BG1()
local integer Ve
if U4==0 then
return 0
endif
set kr[U4]=12
set Ve=U4
return U4
endfunction
function BHO takes player Zx,string Vp,string ap returns boolean
return RequestExtraBooleanData(4,Zx,Vp,ap,false,0,0,0)
endfunction
function BHP takes player Zx,string Vp returns string
return RequestExtraStringData(5,Zx,Vp,null,false,0,0,0)
endfunction
function BHW takes player Zx returns integer
return RequestExtraIntegerData(6,Zx,null,null,false,0,0,0)
endfunction
function BHv takes player Zx,string Vp returns integer
return RequestExtraIntegerData(41,Zx,Vp,null,false,0,0,0)
endfunction
function BHx takes player Zx,integer eb,boolean ec returns boolean
return RequestExtraBooleanData(43,Zx,null,null,ec,eb,0,0)
endfunction
function BHy takes player Zx returns boolean
if BHW(Zx)==0 then
return true
else
return false
endif
endfunction
function BH1 takes player Zx,string Vp,integer ap returns nothing
set Vp="I"+Vp
call BHO(Zx,Vp,I2S(ap))
set Vp=null
set Zx=null
endfunction
function BH2 takes player Zx,string Vp returns integer
local integer ap
set Vp="I"+Vp
set ap=S2I(BHP(Zx,Vp))
set Vp=null
set Zx=null
return ap
endfunction
function BIX takes player Zx,integer er returns boolean
return RequestExtraBooleanData(53,Zx,null,null,false,er,0,0)
endfunction
