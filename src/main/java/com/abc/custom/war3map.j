call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：达顿教授？你怎么也过来了...")
call TriggerSleepAction(2.)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授|r：我看附近怪物不多，就走过来了。不用担心，我带了激光炮防身。")
