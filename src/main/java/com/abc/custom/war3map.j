if GetUnitAbilityLevel(GetFilterUnit(),$416C6F63)<=0 then
call TriggerRegisterUnitEvent(cn,GetFilterUnit(),EVENT_UNIT_DAMAGED)
endif
return false
endfunction
function BMp takes nothing returns nothing
