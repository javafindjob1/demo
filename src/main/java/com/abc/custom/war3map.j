set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if GetItemType(GetManipulatedItem())==ITEM_TYPE_PERMANENT and GetItemType(UnitItemInSlotBJ(GetManipulatingUnit(),bj_forLoopAIndex))==ITEM_TYPE_PERMANENT and GetManipulatedItem()!=UnitItemInSlotBJ(GetTriggerUnit(),bj_forLoopAIndex) then
