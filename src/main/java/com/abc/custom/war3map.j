function BZ0 takes nothing returns nothing
local timer Zy
call SaveInteger(U3,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$6B7AAF69,1)
set Zy=CreateTimer()
call SaveUnitHandle(Vg,GetHandleId(Zy),$458B7DE9,GetTriggerUnit())
call TimerStart(Zy,1.,false,function BZz)
set Zy=null
