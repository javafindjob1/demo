call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$25F62AE1,2)
else
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$25F62AE1,0)
endif
set Zw=1
loop
