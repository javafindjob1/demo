exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if GetItemType(GetManipulatedItem())==ITEM_TYPE_ARTIFACT and GetItemType(UnitItemInSlotBJ(GetManipulatingUnit(),bj_forLoopAIndex))==ITEM_TYPE_ARTIFACT and GetManipulatedItem()!=UnitItemInSlotBJ(GetTriggerUnit(),bj_forLoopAIndex) then
call UnitRemoveItemSwapped(GetManipulatedItem(),GetManipulatingUnit())
