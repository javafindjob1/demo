function BMy takes unit d6,unit d7 returns nothing
local item array d8
local item array d9
local integer VS=0
call BJm(I2S(BJR(d6)),"YDWEItemAbilitySystemTriggerClose",true)
call SetUnitOwner(d7,GetOwningPlayer(d6),false)
loop
exitwhen VS>5
if UnitItemInSlot(d6,VS)!=null then
set d8[VS]=UnitItemInSlot(d6,VS)
call UnitRemoveItemFromSlot(d6,VS)
endif
if UnitItemInSlot(d7,VS)!=null then
set d9[VS]=UnitItemInSlot(d7,VS)
call UnitRemoveItemFromSlot(d7,VS)
endif
set VS=VS+1
endloop
set VS=0
loop
exitwhen VS>5
if d8[VS]==null then
call UnitAddItem(d7,CreateItem($73747067,GetUnitX(d7),GetUnitY(d7)))
else
call UnitAddItem(d7,d8[VS])
endif
set VS=VS+1
endloop
set VS=0
loop
exitwhen VS>5
if d9[VS]==null then
call UnitAddItem(d6,CreateItem($73747067,GetUnitX(d6),GetUnitY(d6)))
else
call UnitAddItem(d6,d9[VS])
endif
set VS=VS+1
endloop
set VS=0
loop
exitwhen VS>5
if GetItemTypeId(UnitItemInSlot(d6,VS))==$73747067 then
call RemoveItem(UnitItemInSlot(d6,VS))
endif
if GetItemTypeId(UnitItemInSlot(d7,VS))==$73747067 then
call RemoveItem(UnitItemInSlot(d7,VS))
endif
set VS=VS+1
endloop
set VS=0
loop
exitwhen VS>5
set d8[VS]=null
set d9[VS]=null
set VS=VS+1
endloop
call SetUnitOwner(d7,Player(PLAYER_NEUTRAL_PASSIVE),false)
call BJm(I2S(BJR(d6)),"YDWEItemAbilitySystemTriggerClose",false)
endfunction
function BMz takes nothing returns boolean
local unit Sr=null
local trigger bg=GetTriggeringTrigger()
local unit d1=GetTriggerUnit()
local integer d2=BJc(I2S(BJR(bg)),"Ability")
local integer d5=BJc(I2S(BJR(bg)),"ItemSlotMax")
local integer VS=0
if GetSpellAbilityId()!=d2 then
set Sr=null
set bg=null
set d1=null
return false
endif
if d5==1 then
set Sr=null
set bg=null
set d1=null
return false
endif
set VS=BJc(I2S(BJR(bg)),"ItemSlotNum")
set VS=VS+1
if VS>d5 then
set VS=1
endif
call BJa(I2S(BJR(bg)),"ItemSlotNum",VS)
set Sr=BJs(I2S(BJR(bg)),I2S(VS))
call BMy(d1,Sr)
call SetUnitAbilityLevel(d1,d2,VS)
if VS==1 then
call BJq(I2S(BJR(bg)),I2S(d5),Sr)
else
call BJq(I2S(BJR(bg)),I2S(VS-1),Sr)
endif
set Sr=null
set bg=null
set d1=null
return false
endfunction
function BM0 takes unit d1,integer d2,integer d3,integer d4 returns nothing
local integer VS=BJc(I2S(BJR(d1)),"MulItemSlotByAbility")
local trigger bg=null
local unit Sr=null
if VS==0 then
set bg=CreateTrigger()
call TriggerRegisterUnitEvent(bg,d1,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(bg,Condition(function BMz))
call BKJ(I2S(BJR(d1)),"MulItemSlotByAbility",bg)
call BJa(I2S(BJR(bg)),"Ability",d2)
call BJa(I2S(BJR(bg)),"ItemSlotMax",d4)
call BJa(I2S(BJR(bg)),"ItemSlotNum",1)
if d4>1 then
loop
exitwhen d4==1
set Sr=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),d3,0,0,0)
call BJm(I2S(BJR(Sr)),"YDWEItemAbilitySystemTriggerClose",true)
call BJq(I2S(BJR(bg)),I2S(d4),Sr)
set d4=d4-1
set Sr=null
endloop
endif
endif
set bg=null
endfunction
function BM3 takes real cW,location l1,code wF returns nothing
local rect Zr
local real wG=GetLocationX(l1)
local real wH=GetLocationY(l1)
if cW>=0 then
set bj_enumDestructableCenter=l1
set bj_enumDestructableRadius=cW
set Zr=Rect(wG-cW,wH-cW,wG+cW,wH+cW)
call EnumDestructablesInRect(Zr,Filter(function BMQ),wF)
call RemoveRect(Zr)
set Zr=null
endif
endfunction
function BM4 takes rect Zr returns group
return BMb(Zr,null)
endfunction
function BM5 takes nothing returns nothing
local timer Vm=GetExpiredTimer()
local unit d1=BJs(I2S(BJR(Vm)),"Hero")
local real kj=BJg(I2S(BJR(Vm)),"Angle")
local integer mh=BJc(I2S(BJR(Vm)),"steeps")
local integer mb=BJc(I2S(BJR(Vm)),"steepsMax")
local real ma=BJg(I2S(BJR(Vm)),"heightMax")
local real mf=BJg(I2S(BJR(Vm)),"dist")
local real mg=BJg(I2S(BJR(Vm)),"dheig")
local real mc=BJg(I2S(BJR(Vm)),"OriginHeight")
local real lC=BJg(I2S(BJR(Vm)),"X")
local real lD=BJg(I2S(BJR(Vm)),"Y")
local real mj=0
local real mk=0
local real ml=0
local integer mi=me
local integer md=BJc(I2S(BJR(d1)),"lvUnitMove")
if mh<mb and mi>=md then
set mj=lC+mh*mf*Cos(kj*3.14159/180.)
set mk=lD+mh*mf*Sin(kj*3.14159/180.)
set mj=BLw(mj)
set mk=BLx(mk)
call SetUnitX(d1,mj)
call SetUnitY(d1,mk)
set mh=mh+1
call BJa(I2S(BJR(Vm)),"steeps",mh)
set ml=(-(2*I2R(mh)*mg-1)*(2*I2R(mh)*mg-1)+1)*ma+mc
call SetUnitFlyHeight(d1,ml,99999)
call SetUnitFacing(d1,kj)
else
call SetUnitFlyHeight(d1,mc,99999)
call SetUnitPathing(d1,true)
call DestroyTimer(Vm)
call BJU(I2S(BJR(Vm)))
call BJa(I2S(BJR(d1)),"lvUnitMove",0)
call BL9(d1,2)
endif
set Vm=null
set d1=null
endfunction
function BM6 takes unit d1,real kj,real kk,real kY,real kZ,real ma returns nothing
local timer Vm=null
local real lC=GetUnitX(d1)
local real lD=GetUnitY(d1)
local integer mb=R2I(kY/kZ)
local integer mh=0
local real mf=kk/mb
local real mg=1./mb
local real mc=GetUnitFlyHeight(d1)
local integer md=BJc(I2S(BJR(d1)),"lvUnitMove")
if me<=md then
return
endif
set Vm=CreateTimer()
call BJa(I2S(BJR(d1)),"lvUnitMove",me)
call BL1(d1)
call SetUnitPathing(d1,false)
call BJq(I2S(BJR(Vm)),"Hero",d1)
call BJe(I2S(BJR(Vm)),"OriginHeight",mc)
call BJe(I2S(BJR(Vm)),"Angle",kj)
call BJe(I2S(BJR(Vm)),"dist",mf)
call BJe(I2S(BJR(Vm)),"heightMax",ma)
call BJe(I2S(BJR(Vm)),"dheig",mg)
call BJe(I2S(BJR(Vm)),"X",lC)
call BJe(I2S(BJR(Vm)),"Y",lD)
call BJa(I2S(BJR(Vm)),"steeps",mh)
call BJa(I2S(BJR(Vm)),"steepsMax",mb)
call TimerStart(Vm,kZ,true,function BM5)
set Vm=null
endfunction
function BM7 takes unit am,unit BBE,real dZ returns nothing
local location BBF=GetUnitLoc(BBE)
call BMm(am,BBF,dZ)
call RemoveLocation(BBF)
set BBF=null
endfunction
function BM9 takes nothing returns nothing
local integer VS=0
loop
exitwhen VS>=WL
