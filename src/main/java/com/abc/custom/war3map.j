call SetStartLocPrio(3,1,2,MAP_LOC_PRIO_HIGH)
endfunction
function main takes nothing returns nothing
call SetCameraBounds(-30848.+GetCameraMargin(CAMERA_MARGIN_LEFT),-28800.+GetCameraMargin(CAMERA_MARGIN_BOTTOM),29824.-GetCameraMargin(CAMERA_MARGIN_RIGHT),31872.-GetCameraMargin(CAMERA_MARGIN_TOP),-30848.+GetCameraMargin(CAMERA_MARGIN_LEFT),31872.-GetCameraMargin(CAMERA_MARGIN_TOP),29824.-GetCameraMargin(CAMERA_MARGIN_RIGHT),-28800.+GetCameraMargin(CAMERA_MARGIN_BOTTOM))
call SetDayNightModels("Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl","Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl")
call SetTerrainFogEx(0,1000.,15000.,.5,.502,.502,.502)
call SetWaterBaseColor(255,128,128,255)
call NewSoundEnvironment("Default")
call SetAmbientDaySound("CityScapeDay")
call SetAmbientNightSound("CityScapeNight")
call SetMapMusic("Music",true,0)
call BOS()
call BOR()
call BOW()
call BOX()
call BOT()
call BOU()
call BOV()
call InitBlizzard()
call ExecuteFunc("DDS")
call ExecuteFunc("BJF")
