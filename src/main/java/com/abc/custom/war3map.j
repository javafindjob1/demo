call AddSpecialEffectTargetUnitBJ("origin",aL[Zw],"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
set Zw=Zw+1
endloop
call TriggerSleepAction(1.)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
call EnableTrigger(BGt)
call FlushChildHashtable(Vg,GetHandleId(GetTriggeringTrigger())*Z1)
endfunction
function DDB takes nothing returns nothing
set BGr=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(BGr,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(BGr,Condition(function DC3))
call TriggerAddAction(BGr,function DC9)
endfunction
function DDC takes nothing returns boolean
return GetUnitTypeId(GetEventDamageSource())==$48303038 and RectContainsUnit(OK,GetTriggerUnit())==true and RectContainsUnit(OK,GetEventDamageSource())==true and GetOwningPlayer(GetTriggerUnit())==Player(6) and GetEventDamage()>=5.
endfunction
function DDD takes nothing returns nothing
call SaveInteger(U3,GetHandleId(GetTriggerUnit()),$2C26E10D,1)
call ExplodeUnitBJ(GetTriggerUnit())
endfunction
function DDE takes nothing returns nothing
set BGu=CreateTrigger()
call BMq(BGu)
call TriggerAddCondition(BGu,Condition(function DDC))
call TriggerAddAction(BGu,function DDD)
endfunction
function DDF takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),$416C6F63)==0 and IsUnitAlly(GetTriggerUnit(),Player(5))==true and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3)
endfunction
function DDG takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffcc99ff极其浓稠的瘴气挡住了洞口......|r")
endfunction
function DDH takes nothing returns nothing
set BGt=CreateTrigger()
call DisableTrigger(BGt)
call BMu(BGt,Ob)
call TriggerAddCondition(BGt,Condition(function DDF))
call TriggerAddAction(BGt,function DDG)
endfunction
function DDI takes nothing returns nothing
call DisplayTextToPlayer(Player(0),0,0,"检测成功！")
endfunction
function DDJ takes nothing returns nothing
set BGv=CreateTrigger()
call TriggerRegisterPlayerChatEvent(BGv,Player(0),"-cba",true)
call TriggerAddAction(BGv,function DDI)
endfunction
