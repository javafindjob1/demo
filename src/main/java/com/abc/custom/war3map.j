call UnitRemoveItemSwapped(GetManipulatedItem(),GetManipulatingUnit())
call DisplayTimedTextToPlayer(GetOwningPlayer(GetManipulatingUnit()),0,0,3.,"|cffff0000你只能装备一双鞋子|r")
