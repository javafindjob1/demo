function BMf takes multiboard bn,integer bo,integer bp,string ep returns nothing
local integer bt=0
local integer bu=0
local integer br=MultiboardGetRowCount(bn)
local integer bs=MultiboardGetColumnCount(bn)
local multiboarditem bv=null
loop
set bt=bt+1
exitwhen bt>br
if bp==0 or bp==bt then
set bu=0
loop
set bu=bu+1
exitwhen bu>bs
if bo==0 or bo==bu then
set bv=MultiboardGetItem(bn,bt-1,bu-1)
call MultiboardSetItemIcon(bv,ep)
call MultiboardReleaseItem(bv)
endif
endloop
endif
endloop
set bv=null
endfunction
