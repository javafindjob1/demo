function BU7 takes nothing returns nothing
set Zp=CreateTrigger()
call TriggerAddAction(Zp,function BU6)
endfunction
function BU8 takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and IsUnitIllusionBJ(GetTriggerUnit())==false and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3)
endfunction
function BU9 takes nothing returns boolean
return IsUnitAliveBJ(GetFilterUnit())==true and IsUnitType(GetFilterUnit(),UNIT_TYPE_SAPPER)==true
endfunction
function BVB takes nothing returns nothing
local integer Z1=LoadInteger(Vg,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set Z1=Z1+3
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,Z1)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
call SaveLocationHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$32A9E4C8,GetUnitLoc(GetTriggerUnit()))
call SaveGroupHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$214C62CC,BMa(900.,LoadLocationHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$32A9E4C8),Condition(function BU9)))
call SaveUnitHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$B37CFB7B,FirstOfGroup(LoadGroupHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$214C62CC)))
if GetOwningPlayer(LoadUnitHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$B37CFB7B))==Player(PLAYER_NEUTRAL_PASSIVE) then
call SetUnitOwner(LoadUnitHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$B37CFB7B),Player(5),true)
call QuestMessageBJ(GetPlayersAll(),bj_QUESTMESSAGE_ITEMACQUIRED,"|cffffcc00发现新的记忆石碑！|r")
