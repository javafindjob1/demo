if LoadInteger(U3,GetHandleId(OB),$27DE06AF)<=11 then
call DisplayTimedTextToForce(GetPlayersAll(),2.,"|cff80ff80挑战成功！接下来是.....|r")
call SaveInteger(U3,GetHandleId(OB),$27DE06AF,LoadInteger(U3,GetHandleId(OB),$27DE06AF)+1)
