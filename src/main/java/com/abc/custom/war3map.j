call ExecuteFunc("BNz")
call ExecuteFunc("BOK")
call BOQ()
call DDK()
call DDL()
endfunction
function config takes nothing returns nothing
call SetMapName("西方世界的劫难7：卡夫卡的宝藏")
call SetMapDescription("西方7，全新的冒险")
call SetPlayers(7)
call SetTeams(7)
call SetGamePlacement(MAP_PLACEMENT_TEAMS_TOGETHER)
call DefineStartLocation(0,28928.,29632.)
call DefineStartLocation(2,28928.,29568.)
call DefineStartLocation(1,28864.,29568.)
call DefineStartLocation(3,28992.,29568.)
call DefineStartLocation(4,28928.,29504.)
call DefineStartLocation(5,28928.,29440.)
call DefineStartLocation(6,28928.,29504.)
call DDM()
call DDN()
call DDO()
endfunction
function DDP takes nothing returns boolean
local integer U4=U1
call BJU("YDWEStringFormula."+I2S(U4))
return true
endfunction
function DDQ takes nothing returns boolean
local integer U4=U1
call BNl(U9[U4])
call BNl(VB[U4])
call GroupClear(VC[U4])
call DestroyGroup(VC[U4])
call PauseTimer(VB[U4])
call DestroyTimer(VB[U4])
call BG4(VF[U4])
call BG4(VG[U4])
call BG4(VH[U4])
set VI[U4]=null
set VJ[U4]=null
set U9[U4]=null
set VC[U4]=null
set VB[U4]=null
set VK[U4]=0
set VL[U4]=0
set VM[U4]=0
set VN[U4]=""
set VO[U4]=""
set VP[U4]=""
set VQ[U4]=""
return true
endfunction
function DDR takes nothing returns boolean
local integer U4=U1
local integer VS=0
loop
exitwhen VS==VT
set VU[VV[U4]+VS]=0
set VW[VX[U4]+VS]=0
set VS=VS+1
endloop
set VY[U4]=""
return true
endfunction
function DDS takes nothing returns nothing
set U0[1]=CreateTrigger()
set U0[2]=U0[1]
call TriggerAddCondition(U0[1],Condition(function DDP))
set U5[9]=CreateTrigger()
set U5[10]=U5[9]
set U5[11]=U5[9]
set U5[12]=U5[9]
call TriggerAddCondition(U5[9],Condition(function DDQ))
set VR=CreateTrigger()
call TriggerAddCondition(VR,Condition(function DDR))
call ExecuteFunc("BNO")
call ExecuteFunc("BNS")
endfunction
