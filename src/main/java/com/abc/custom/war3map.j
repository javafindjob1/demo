function BMk takes real dZ returns nothing
local timer Vm
local real da
if dZ>0 then
set Vm=CreateTimer()
call TimerStart(Vm,dZ,false,null)
loop
set da=TimerGetRemaining(Vm)
exitwhen da<=0
if da>bj_POLLED_WAIT_SKIP_THRESHOLD then
call TriggerSleepAction(.1*da)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
call DestroyTimer(Vm)
endif
set Vm=null
endfunction
function BMl takes unit am,integer BB9,integer BCB returns unit
local unit BCD=am
local unit BCE
local boolean BCC
local integer Wh
local item BCG
local real BCF
if am==null then
set bj_lastReplacedUnit=am
return bj_lastReplacedUnit
endif
set BCC=IsUnitHidden(BCD)
call ShowUnit(BCD,false)
if BB9==$75676F6C then
set BCE=CreateBlightedGoldmine(GetOwningPlayer(BCD),GetUnitX(BCD),GetUnitY(BCD),GetUnitFacing(BCD))
else
set BCE=CreateUnit(GetOwningPlayer(BCD),BB9,GetUnitX(BCD),GetUnitY(BCD),GetUnitFacing(BCD))
endif
if BCB==bj_UNIT_STATE_METHOD_RELATIVE then
if GetUnitState(BCD,UNIT_STATE_MAX_LIFE)>0 then
set BCF=GetUnitState(BCD,UNIT_STATE_LIFE)/GetUnitState(BCD,UNIT_STATE_MAX_LIFE)
call SetUnitState(BCE,UNIT_STATE_LIFE,BCF*GetUnitState(BCE,UNIT_STATE_MAX_LIFE))
endif
if GetUnitState(BCD,UNIT_STATE_MAX_MANA)>0 and GetUnitState(BCE,UNIT_STATE_MAX_MANA)>0 then
set BCF=GetUnitState(BCD,UNIT_STATE_MANA)/GetUnitState(BCD,UNIT_STATE_MAX_MANA)
call SetUnitState(BCE,UNIT_STATE_MANA,BCF*GetUnitState(BCE,UNIT_STATE_MAX_MANA))
endif
elseif BCB==bj_UNIT_STATE_METHOD_ABSOLUTE then
call SetUnitState(BCE,UNIT_STATE_LIFE,GetUnitState(BCD,UNIT_STATE_LIFE))
if GetUnitState(BCE,UNIT_STATE_MAX_MANA)>0 then
call SetUnitState(BCE,UNIT_STATE_MANA,GetUnitState(BCD,UNIT_STATE_MANA))
endif
elseif BCB==bj_UNIT_STATE_METHOD_DEFAULTS then
elseif BCB==bj_UNIT_STATE_METHOD_MAXIMUM then
call SetUnitState(BCE,UNIT_STATE_LIFE,GetUnitState(BCE,UNIT_STATE_MAX_LIFE))
call SetUnitState(BCE,UNIT_STATE_MANA,GetUnitState(BCE,UNIT_STATE_MAX_MANA))
else
endif
call SetResourceAmount(BCE,GetResourceAmount(BCD))
if IsUnitType(BCD,UNIT_TYPE_HERO) and IsUnitType(BCE,UNIT_TYPE_HERO) then
call SetHeroXP(BCE,GetHeroXP(BCD),false)
set Wh=0
loop
set BCG=UnitItemInSlot(BCD,Wh)
if BCG!=null then
call UnitRemoveItem(BCD,BCG)
call UnitAddItem(BCE,BCG)
endif
set Wh=Wh+1
exitwhen Wh>=bj_MAX_INVENTORY
endloop
endif
if BCC then
call KillUnit(BCD)
call RemoveUnit(BCD)
else
call RemoveUnit(BCD)
endif
set bj_lastReplacedUnit=BCE
set BCD=null
set BCE=null
set BCG=null
return bj_lastReplacedUnit
endfunction
function BMm takes unit am,location BBE,real dZ returns nothing
