function BTI takes nothing returns nothing
if GetItemLifeBJ(GetEnumItem())<=300. and GetItemType(GetEnumItem())==ITEM_TYPE_POWERUP or GetItemType(GetEnumItem())==ITEM_TYPE_CHARGED then
call SetWidgetLife(GetEnumItem(),GetItemLifeBJ(GetEnumItem())-1.)
if GetItemLifeBJ(GetEnumItem())<1. then
call SetWidgetLife(GetEnumItem(),2.)
call FlushChildHashtable(U3,GetHandleId(GetEnumItem()))
call RemoveItem(GetEnumItem())
else
endif
else
if GetItemTypeId(GetEnumItem())==$73747067 then
call SetWidgetLife(GetEnumItem(),2.)
call FlushChildHashtable(U3,GetHandleId(GetEnumItem()))
call RemoveItem(GetEnumItem())
else
endif
endif
endfunction
