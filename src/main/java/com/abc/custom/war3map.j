local integer Z1=LoadInteger(Vg,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set Z1=Z1+3
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,Z1)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
call ForceRemovePlayer(X8,GetTriggerPlayer())
set XP=CountPlayersInForceBJ(X8)
call GroupRemoveUnit(W1,aL[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToForce(GetPlayersAll(),3.,"|cffcc99ff"+GetPlayerName(GetTriggerPlayer())+"|r离开了游戏.......")
call SaveLocationHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$32A9E4C8,GetUnitLoc(aL[GetConvertedPlayerId(GetTriggerPlayer())]))
set bl=1
loop
exitwhen bl>6
call SetItemPositionLoc(UnitItemInSlotBJ(aL[GetConvertedPlayerId(GetTriggerPlayer())],bl),LoadLocationHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$32A9E4C8))
call SetItemPositionLoc(UnitItemInSlotBJ(bm[GetConvertedPlayerId(GetTriggerPlayer())],bl),LoadLocationHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$32A9E4C8))
set bl=bl+1
endloop
call RemoveLocation(LoadLocationHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$32A9E4C8))
call BMh(GetLastCreatedMultiboard(),GetConvertedPlayerId(GetTriggerPlayer()),1,"|cff999999"+GetPlayerName(Zc[GetConvertedPlayerId(GetTriggerPlayer())])+"|r")
call BMh(GetLastCreatedMultiboard(),GetConvertedPlayerId(GetTriggerPlayer()),2,"|cff999999"+GetUnitName(aL[GetConvertedPlayerId(GetTriggerPlayer())])+"|r")
call MultiboardDisplay(bj_lastCreatedMultiboard,true)
call FlushChildHashtable(Vg,GetHandleId(GetTriggeringTrigger())*Z1)
endfunction
