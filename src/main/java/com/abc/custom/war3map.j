function BZs takes nothing returns nothing
set Zg=CreateTrigger()
call TriggerAddAction(Zg,function BZr)
endfunction
function BZt takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and IsUnitIllusionBJ(GetTriggerUnit())==false and GetUnitLevel(GetTriggerUnit())==1 and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3) and LoadInteger(U3,GetHandleId(GetTriggerUnit()),$BC0452BD)==0
endfunction
function BZu takes nothing returns nothing
local integer Z1=LoadInteger(Vg,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set Z1=Z1+3
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,Z1)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
call SavePlayerHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$48656946,GetOwningPlayer(GetTriggerUnit()))
call SaveInteger(U3,GetHandleId(GetTriggerUnit()),$BC0452BD,1)
if Xi[GetConvertedPlayerId(LoadPlayerHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$48656946))]>=4 then
call UnitAddAbility(GetTriggerUnit(),$41304C36)
call SetPlayerAbilityAvailable(LoadPlayerHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$48656946),$41304C36,false)
else
endif
if DzAPI_Map_GetMapLevel(LoadPlayerHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$48656946))>=50 then
call UnitAddAbility(GetTriggerUnit(),$41304C37)
call SetPlayerAbilityAvailable(LoadPlayerHandle(Vg,GetHandleId(GetTriggeringTrigger())*Z1,$48656946),$41304C37,false)
else
endif
call FlushChildHashtable(Vg,GetHandleId(GetTriggeringTrigger())*Z1)
endfunction
function BZv takes nothing returns nothing
set gF=CreateTrigger()
call BMu(gF,DX)
call TriggerAddCondition(gF,Condition(function BZt))
call TriggerAddAction(gF,function BZu)
endfunction
function BZw takes nothing returns nothing
local integer bl
set bl=1
loop
exitwhen bl>4
if Xf[bl]>=3 and BI1(Zc[bl])!="星悦丶宏愿#8501" then
set Xf[bl]=0
else
endif
if XS[100*bl+36]>=1002 then
set XS[100*bl+36]=0
else
endif
set bl=bl+1
endloop
endfunction
function BZx takes nothing returns nothing
set gG=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(gG,3.)
call TriggerAddAction(gG,function BZw)
endfunction
function BZy takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3) and LoadInteger(U3,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$6B7AAF69)==0
