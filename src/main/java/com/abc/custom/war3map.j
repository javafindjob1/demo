function BGx takes nothing returns integer
local integer U4=Va
if U4!=0 then
set Va=Vb[U4]
else
set Vc=Vc+1
set U4=Vc
endif
if U4>8190 then
return 0
endif
set Vd[U4]=1
set Vb[U4]=-1
return U4
endfunction
function BGz takes nothing returns integer
local integer U4=BGx()
local integer Ve
if U4==0 then
return 0
endif
set Vd[U4]=2
set Ve=U4
return U4
endfunction
function BG1 takes nothing returns integer
local integer U4=ko
if U4!=0 then
set ko=kp[U4]
else
set kq=kq+1
set U4=kq
endif
if U4>8190 then
return 0
endif
set kr[U4]=9
set kp[U4]=-1
return U4
endfunction
function BG2 takes integer U4 returns nothing
if U4==null then
return
elseif kp[U4]!=-1 then
return
endif
set U1=U4
call TriggerEvaluate(U5[kr[U4]])
set kp[U4]=ko
set ko=U4
endfunction
function BG3 takes nothing returns integer
local integer U4=VE
if U4!=0 then
set VE=VD[U4]
else
set ks=ks+1
set U4=ks
endif
