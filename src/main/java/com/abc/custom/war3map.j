call TriggerSleepAction(6.)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
else
call TriggerSleepAction(4.)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
endif
if LoadInteger(U3,GetHandleId(OB),$27DE06AF)==2 then
call SaveInteger(U3,GetHandleId(OB),$A9E584DA,1)
call DisplayTimedTextToForce(GetPlayersAll(),5.,"|cffff9900第二组：禁卫夫人|r")
call TriggerSleepAction(2.)
call SaveInteger(Vg,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Z1)
