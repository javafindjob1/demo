if GetItemType(GetManipulatedItem())==ITEM_TYPE_POWERUP and GetItemCharges(BMY(GetManipulatingUnit(),GetItemTypeId(GetManipulatedItem())))>=1 and GetManipulatedItem()!=UnitItemInSlotBJ(GetTriggerUnit(),bj_forLoopAIndex) and GetItemTypeId(GetManipulatedItem())==GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(),bj_forLoopAIndex)) and GetItemCharges(UnitItemInSlotBJ(GetManipulatingUnit(),bj_forLoopAIndex))+GetItemCharges(GetManipulatedItem())<=20 then
call SetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(),bj_forLoopAIndex),GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(),bj_forLoopAIndex))+GetItemCharges(GetManipulatedItem()))
