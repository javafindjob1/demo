function C_p takes nothing returns nothing
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call GroupRemoveUnit(YE,GetTriggerUnit())
if CountUnitsInGroup(YE)<=4 then
call DisableTrigger(GetTriggeringTrigger())
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D,GroupPickRandomUnit(BM8(2000.,GetRectCenter(HY),Condition(function C_o))))
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D))+"|r：这些血巨人真是恶心到我了...")
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call PanCameraToTimedLocForPlayer(GetOwningPlayer(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D)),GetRectCenter(Hg),.5)
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8,GetDestructableLoc(Q0))
call KillDestructable(Q0)
