function BNJ takes real dk returns nothing
local timer Vt
local real dl
if dk>0 then
set Vt=CreateTimer()
call TimerStart(Vt,dk,false,null)
loop
set dl=TimerGetRemaining(Vt)
exitwhen dl<=0
if dl>bj_POLLED_WAIT_SKIP_THRESHOLD then
call TriggerSleepAction(.1*dl)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
call DestroyTimer(Vt)
endif
set Vt=null
endfunction
function BNK takes unit ax,integer e4,integer e5 returns unit
local unit e7=ax
local unit e8
local boolean e6
local integer Wo
local item fB
local real e9
if ax==null then
set bj_lastReplacedUnit=ax
return bj_lastReplacedUnit
endif
set e6=IsUnitHidden(e7)
call ShowUnit(e7,false)
if e4=='ugol' then
set e8=CreateBlightedGoldmine(GetOwningPlayer(e7),GetUnitX(e7),GetUnitY(e7),GetUnitFacing(e7))
else
set e8=CreateUnit(GetOwningPlayer(e7),e4,GetUnitX(e7),GetUnitY(e7),GetUnitFacing(e7))
endif
if e5==bj_UNIT_STATE_METHOD_RELATIVE then
if GetUnitState(e7,UNIT_STATE_MAX_LIFE)>0 then
set e9=GetUnitState(e7,UNIT_STATE_LIFE)/GetUnitState(e7,UNIT_STATE_MAX_LIFE)
call SetUnitState(e8,UNIT_STATE_LIFE,e9*GetUnitState(e8,UNIT_STATE_MAX_LIFE))
endif
if GetUnitState(e7,UNIT_STATE_MAX_MANA)>0 and GetUnitState(e8,UNIT_STATE_MAX_MANA)>0 then
set e9=GetUnitState(e7,UNIT_STATE_MANA)/GetUnitState(e7,UNIT_STATE_MAX_MANA)
call SetUnitState(e8,UNIT_STATE_MANA,e9*GetUnitState(e8,UNIT_STATE_MAX_MANA))
endif
elseif e5==bj_UNIT_STATE_METHOD_ABSOLUTE then
call SetUnitState(e8,UNIT_STATE_LIFE,GetUnitState(e7,UNIT_STATE_LIFE))
if GetUnitState(e8,UNIT_STATE_MAX_MANA)>0 then
call SetUnitState(e8,UNIT_STATE_MANA,GetUnitState(e7,UNIT_STATE_MANA))
endif
elseif e5==bj_UNIT_STATE_METHOD_DEFAULTS then
elseif e5==bj_UNIT_STATE_METHOD_MAXIMUM then
call SetUnitState(e8,UNIT_STATE_LIFE,GetUnitState(e8,UNIT_STATE_MAX_LIFE))
call SetUnitState(e8,UNIT_STATE_MANA,GetUnitState(e8,UNIT_STATE_MAX_MANA))
else
endif
call SetResourceAmount(e8,GetResourceAmount(e7))
if IsUnitType(e7,UNIT_TYPE_HERO) and IsUnitType(e8,UNIT_TYPE_HERO) then
call SetHeroXP(e8,GetHeroXP(e7),false)
set Wo=0
loop
set fB=UnitItemInSlot(e7,Wo)
if fB!=null then
call UnitRemoveItem(e7,fB)
call UnitAddItem(e8,fB)
endif
set Wo=Wo+1
exitwhen Wo>=bj_MAX_INVENTORY
endloop
endif
if e6 then
call KillUnit(e7)
call RemoveUnit(e7)
else
call RemoveUnit(e7)
endif
set bj_lastReplacedUnit=e8
set e7=null
set e8=null
set fB=null
return bj_lastReplacedUnit
endfunction
function BNL takes unit ax,location BCO,real dk returns nothing
local location BCP=GetUnitLoc(ax)
call SetUnitFacingTimed(ax,AngleBetweenPoints(BCP,BCO),dk)
call RemoveLocation(BCP)
set BCP=null
endfunction
