call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffff77ff哥布林神棍坎特|r：我能听懂独角兽语，要不是你及时出现，她就成了僵尸的晚餐了，所以后来她会帮你冲破山谷的大门。")
call TriggerSleepAction(3.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
