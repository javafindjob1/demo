if LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$50BBB8)==3 then
call CreateItemLoc('guvi',LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$72E90FA0))
else
if LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$50BBB8)==4 then
call CreateItemLoc(aE[GetRandomInt(7,9)],LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$72E90FA0))
else
call CreateNUnitsAtLoc(1,'nslh',Player(6),LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$72E90FA0),GetRandomDirectionDeg())
call SaveInteger(VB,GetHandleId(GetLastCreatedUnit()),$2C26E10D,1)
endif
endif
endif
endif
else
endif
call RemoveLocation(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$72E90FA0))
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
