endif
if VC>8190 then
return 0
endif
set l4[VC]=9
set l2[VC]=-1
return VC
endfunction
function BHb takes integer VC returns nothing
if VC==null then
return
elseif l2[VC]!=-1 then
return
endif
set U8=VC
call TriggerEvaluate(VD[l4[VC]])
set l2[VC]=l1
set l1=VC
endfunction
function BHc takes nothing returns integer
local integer VC=VL
if VC!=0 then
set VL=VK[VC]
else
