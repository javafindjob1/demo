function C8x takes nothing returns nothing
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$32A9E4C8,GetUnitLoc(GetEnumUnit()))
if GetTerrainTypeBJ(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$32A9E4C8))=='Yblm' and BNV(GetEnumUnit(),'I089')==false and GetUnitTypeId(GetEnumUnit())!='H01E' then
call UnitDamageTarget(BD7,GetEnumUnit(),GetUnitState(GetEnumUnit(),UNIT_STATE_MAX_LIFE)*.07/3.,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_ACID,WEAPON_TYPE_WHOKNOWS)
if ModuloInteger(YQ,3)==1 then
call AddSpecialEffectTargetUnitBJ("origin",GetEnumUnit(),"Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayDamage.mdl")
call BOl(1.,bj_lastCreatedEffect)
else
endif
else
endif
call RemoveLocation(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$32A9E4C8))
endfunction
