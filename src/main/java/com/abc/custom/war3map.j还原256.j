call TriggerSleepAction(3.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80"+"达顿教授"+"|r：嗯，我叫|cff00ccff达顿.卡夫卡|r，是这艘地下飞船的主人。我身后的门就是通往地下世界的入口。|cffffcc00请先进去吧|r，随后我会通过心灵波告诉你这里的一切....")
call SetDoodadAnimationBJ("hide",'D00M',350.,Location(-27300.,-25099.))
call AddSpecialEffectLocBJ(Location(-27300.,-25099.),"Doodads\\Dungeon\\Props\\Forcewall\\Forcewall.mdl")
call EXEffectMatScale(bj_lastCreatedEffect,.6,.6,1.4)
call EXEffectMatRotateZ(bj_lastCreatedEffect,45.)
call DestroyEffect(GetLastCreatedEffectBJ())
call EnumDestructablesInRectAll(DT,function CyW)
call SaveInteger(VB,GetHandleId(Dp),$239EB877,1)
call TriggerSleepAction(8.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：|cffcc99ff地下世界|r是什么地方？不是说好的去度假村吗？还有这座船舱是怎么回事？")
call TriggerSleepAction(6.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授：我们卡夫卡家族世世代代经营游乐场和度假村，这艘飞船是我爷爷留下的游乐船。有一天，我在船内发现了一个密道，这个密道竟然通往一个神秘的地下世界。|r")
call TriggerSleepAction(7.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授：这个世界充满各种幻境、遗迹和宝物，当然还栖息着大量危险的怪物，我并不擅长战斗，因此邀请各位来探索这个未知的地下世界。|r")
call TriggerSleepAction(7.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：好吧，|cffcc99ff探索地下未知世界|r，就当是此次的度假活动吧。")
call TriggerSleepAction(5.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授：抱歉，向您隐瞒了真正目的。在探险中，你可以使用|cffffcc00传送术|cff80ff80移动到各个石碑处，也可以传送回|cffff77ff飞船泉水和任意房间|r")
call TriggerSleepAction(7.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：是否存在|cffff77ff最终目的？")
call TriggerSleepAction(4.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授：最终目的吗？....|cffff0000我想知道地底最深处在哪里..|cff80ff80另外，我有一位|cffff77ff女同伴|cff80ff80正在地下探索，却久久没回来，如果看到她请将她带回来。她的特征是一头|cffff77ff白色长发。")
call TriggerSleepAction(7.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：白色长发女性...嗯..我知道了。")
call CreateQuestItemBJ(dT[1],"原来达顿司机是飞船主人，真正的度假是探索地底世界")
set dU[13]=GetLastCreatedQuestItemBJ()
call CreateQuestItemBJ(dT[1],"另外，达顿的一名白发女同伴失踪了，路上留意一下。")
set dU[14]=GetLastCreatedQuestItemBJ()
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
