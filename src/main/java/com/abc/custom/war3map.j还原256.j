call ForGroupBJ(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E6D6D2F),function DDQ)
call GroupClear(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E6D6D2F))
