elseif VK[VC]!=-1 then
return
endif
set VK[VC]=VL
set VL=VC
endfunction
function BHf takes nothing returns integer
local integer VC=bb
if VC!=0 then
set bb=bc[VC]
else
set bd=bd+1
set VC=bd
endif
if VC>1022 then
return 0
endif
set Vc[VC]=(VC-1)*8
set Ve[VC]=(VC-1)*8
set be[VC]=7
set bc[VC]=-1
return VC
endfunction
function BHh takes nothing returns integer
local integer VC=BHa()
