endfunction
function Bd1 takes nothing returns nothing
call SaveInteger(VB,GetHandleId(LoadUnitHandle(Vn,GetHandleId(GetExpiredTimer()),$B37CFB7B)),$82450331,LoadInteger(VB,GetHandleId(LoadUnitHandle(Vn,GetHandleId(GetExpiredTimer()),$B37CFB7B)),$82450331)-1)
