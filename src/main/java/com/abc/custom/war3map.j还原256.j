call CreateItemLoc('esaz',iW[17])
set iY[17]=GetLastCreatedItem()
call SetItemVisible(iY[17],false)
if RectContainsItem(iY[17],iX[17])==false or IsTerrainPathableBJ(iW[17],PATHING_TYPE_WALKABILITY)==true then
call SaveBoolean(VB,GetHandleId(iR[17]),$7766443D,true)
call RemoveItem(iY[17])
else
call RemoveItem(iY[17])
endif
set iZ[17]=PolarProjectionBJ(iS[17],I2R(Wp[17]),Wu[17])
call RemoveRect(iX[17])
if LoadBoolean(VB,GetHandleId(iR[17]),$7766443D)==false then
call SetUnitPositionLocFacingBJ(iR[17],iZ[17],Wu[17])
if DistanceBetweenPoints(iZ[17],iT[17])<=60. or IsUnitAliveBJ(iR[17])==false then
call DisableTrigger(GetTriggeringTrigger())
call SetUnitPathing(iR[17],true)
call RemoveLocation(iU[17])
call RemoveLocation(iZ[17])
call RemoveLocation(iS[17])
call RemoveLocation(iT[17])
else
endif
else
call DisableTrigger(GetTriggeringTrigger())
call SetUnitPathing(iR[17],true)
call RemoveLocation(iU[17])
call RemoveLocation(iZ[17])
call RemoveLocation(iS[17])
call RemoveLocation(iT[17])
endif
