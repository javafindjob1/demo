function BOT takes nothing returns nothing
local integer VC=BOI(GetExpiredTimer())
local real mG=GetUnitX(VH[VC])+l8[VC]*l6[VO[VC]]
local real mH=GetUnitY(VH[VC])+l8[VC]*l7[VO[VC]]
if mD[VC]==false then
if IsTerrainPathable(mG,mH,PATHING_TYPE_WALKABILITY) then
set mE[VC]=0
else
call BOL(VC,mG)
call BOM(VC,mH)
endif
else
call BOL(VC,mG)
call BOM(VC,mH)
endif
if mF[VC]==0 then
if GetUnitFlyHeight(VH[VC])<5. then
if IsTerrainPathable(l6[VN[VC]],l7[VN[VC]],PATHING_TYPE_FLOATABILITY) then
call DestroyEffect(AddSpecialEffect(VV[VC],l6[VN[VC]],l7[VN[VC]]))
else
call DestroyEffect(AddSpecialEffect(VW[VC],l6[VN[VC]],l7[VN[VC]]))
endif
endif
endif
set mF[VC]=mF[VC]+1
if mF[VC]==2 then
set mF[VC]=0
endif
if mB[VC] then
call MoveRectTo(WV,l6[VN[VC]],l7[VN[VC]])
call EnumDestructablesInRect(WV,WW,function BOH)
endif
if VR[VC]>0. then
set mJ=VC
call GroupEnumUnitsInRange(VJ[VC],l6[VN[VC]],l7[VN[VC]],120.,Condition(function BOG))
endif
set l8[VC]=l8[VC]-l9[VC]
if l8[VC]<=0. or BMV(l6[VN[VC]])!=l6[VN[VC]] or BMW(l7[VN[VC]])!=l7[VN[VC]] then
set mE[VC]=0
endif
if mE[VC]==0 then
call SetUnitFlyHeight(VH[VC],GetUnitDefaultFlyHeight(VH[VC]),200.)
call SetUnitTimeScale(VH[VC],1)
call BMi(VH[VC],6)
call BHb(VC)
endif
endfunction
function BOU takes unit lw,unit lx,real fF,real fG,real fb,real ly,real lp,boolean lq,boolean lr,boolean ls,string lt,string lz,string l0 returns integer
local integer VC=BHh()
set VM[VC]=BHc()
set VN[VC]=BHc()
set VO[VC]=BHc()
set l6[VO[VC]]=Cos(fF)
set l7[VO[VC]]=Sin(fF)
set l8[VC]=2*fG*ly/fb
set l9[VC]=l8[VC]*ly/fb
set l6[VN[VC]]=GetUnitX(lx)
set l7[VN[VC]]=GetUnitY(lx)
set VP[VC]=lw
set VH[VC]=lx
set VR[VC]=lp
set mB[VC]=lq
set mC[VC]=lr
set mD[VC]=ls
set VV[VC]=lz
set VW[VC]=l0
set mE[VC]=1
set mF[VC]=0
set VJ[VC]=CreateGroup()
set VI[VC]=CreateTimer()
call TimerStart(VI[VC],ly,true,function BOT)
call BOJ(VI[VC],VC)
return VC
endfunction
