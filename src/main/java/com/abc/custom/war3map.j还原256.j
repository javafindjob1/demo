function DDM takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and IsUnitAlly(GetTriggerUnit(),Player(5))==true and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3)
