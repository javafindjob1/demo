call CreateNUnitsAtLoc(1,'n01X',Player(6),LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$72E90FA0),GetRandomDirectionDeg())
call SaveInteger(VB,GetHandleId(GetLastCreatedUnit()),$2C26E10D,1)
