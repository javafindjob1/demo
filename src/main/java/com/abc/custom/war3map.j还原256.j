function C5Z takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and IsUnitAlly(GetTriggerUnit(),Player(5))==true and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true
endfunction
function C5a takes nothing returns nothing
local integer Z7
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisableTrigger(GetTriggeringTrigger())
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTimedTextToForce(GetPlayersAll(),5.,"|cffcc99ff...你已经来到黑曜之城地下竞技场....除了战斗....别无选择...|r")
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTimedTextToForce(GetPlayersAll(),5.,"|cffcc99ff...接下来...你将面对残酷的车轮战.....|r")
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveInteger(VB,GetHandleId(OB),$27DE06AF,1)
if LoadInteger(VB,GetHandleId(OB),$27DE06AF)==1 then
call SaveInteger(VB,GetHandleId(OB),$A9E584DA,1)
call DisplayTimedTextToForce(GetPlayersAll(),5.,"|cffff9900第一组：蜥蜴铁骑|r")
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25F62AE1,XW)
set Z7=1
loop
exitwhen Z7>4+LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25F62AE1)
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$6BD67865,GetRandomLocInRect(OB))
call CreateNUnitsAtLoc(1,'orai',Player(6),LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$6BD67865),GetRandomDirectionDeg())
call SaveInteger(VB,GetHandleId(GetLastCreatedUnit()),$2C26E10D,1)
call GroupAddUnit(X7,GetLastCreatedUnit())
call RemoveLocation(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$6BD67865))
set Z7=Z7+1
endloop
else
endif
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
function C5b takes nothing returns nothing
set BFQ=CreateTrigger()
call BNT(BFQ,OB)
call TriggerAddCondition(BFQ,Condition(function C5Z))
call TriggerAddAction(BFQ,function C5a)
endfunction
function C5c takes nothing returns boolean
return IsUnitInGroup(GetTriggerUnit(),X7)==true and IsUnitGroupDeadBJ(X7)==true and LoadInteger(VB,GetHandleId(OB),$A9E584DA)==1 and ZT==false
endfunction
function C5d takes nothing returns nothing
local integer Z7
local integer eg
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveInteger(VB,GetHandleId(OB),$A9E584DA,0)
call GroupClear(X7)
if LoadInteger(VB,GetHandleId(OB),$27DE06AF)<=11 then
call DisplayTimedTextToForce(GetPlayersAll(),2.,"|cff80ff80挑战成功！接下来是.....|r")
call SaveInteger(VB,GetHandleId(OB),$27DE06AF,LoadInteger(VB,GetHandleId(OB),$27DE06AF)+1)
if LoadInteger(VB,GetHandleId(OB),$27DE06AF)==7 then
call TriggerSleepAction(6.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
else
call TriggerSleepAction(4.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
endif
if LoadInteger(VB,GetHandleId(OB),$27DE06AF)==2 then
