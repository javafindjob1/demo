function BaZ takes nothing returns nothing
local timer Z9
call SaveInteger(VB,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$6B7AAF69,1)
set Z9=CreateTimer()
call SaveUnitHandle(Vn,GetHandleId(Z9),$458B7DE9,GetTriggerUnit())
call TimerStart(Z9,1.,false,function BaY)
set Z9=null
endfunction
function Baa takes nothing returns nothing
set hU=CreateTrigger()
call BNT(hU,DX)
call TriggerAddCondition(hU,Condition(function BaX))
call TriggerAddAction(hU,function BaZ)
endfunction
function Bab takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3) and LoadInteger(VB,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$4ED10CE2)==0
endfunction
