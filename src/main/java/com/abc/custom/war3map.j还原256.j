set bm=BNz(bg,Vu,Vz)
if bm>0 then
set U9=BNq(bm,bg)
set VZ=0
loop
exitwhen VZ>be[bh]
call BNv(Vb[Vc[bh]+VZ],U9)
set VZ=VZ+1
