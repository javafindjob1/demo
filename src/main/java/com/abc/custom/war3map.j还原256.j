call RegionAddRect(Z2,GetWorldBounds())
call TriggerRegisterEnterRegion(Vt,Z2,Condition(function BNN))
call GroupEnumUnitsInRect(Z4,GetWorldBounds(),Condition(function BNN))
call DestroyGroup(Z4)
set Z2=null
set Vt=null
set Z4=null
endfunction
