call SaveInteger(Vn,GetHandleId(GetExpiredTimer()),$ACBD688D,LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$ACBD688D)+XZ[1000*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetExpiredTimer()),'HeiF'))+LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$EEA5806B)])
if LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$EEA5806B)>=18 then
if LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$ACBD688D)>0 then
call UnitAddItemByIdSwapped('pgma',LoadUnitHandle(Vn,GetHandleId(GetExpiredTimer()),$458B7DE9))
else
endif
call FlushChildHashtable(Vn,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
else
endif
endfunction
function BSh takes nothing returns nothing
call SaveInteger(Vn,GetHandleId(GetExpiredTimer()),$1E3A37E2,LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$1E3A37E2)+1)
call SaveInteger(Vn,GetHandleId(GetExpiredTimer()),$9EECCB65,LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$9EECCB65)+XZ[1000*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetExpiredTimer()),'HeiF'))+LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$1E3A37E2)])
if LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$1E3A37E2)>=36 then
if LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$9EECCB65)>0 then
call UnitAddItemByIdSwapped('whwd',LoadUnitHandle(Vn,GetHandleId(GetExpiredTimer()),$458B7DE9))
else
endif
call FlushChildHashtable(Vn,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
else
endif
endfunction
function BSi takes nothing returns nothing
local timer Z9
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SavePlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF',GetOwningPlayer(GetTriggerUnit()))
call SaveInteger(VB,GetHandleId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF')),$ABE0216C,1)
call SaveInteger(VB,GetHandleId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF')),$5F82B56,1)
call UnitAddItemByIdSwapped('pgma',GetTriggerUnit())
call UnitAddItemByIdSwapped('whwd',GetTriggerUnit())
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$9134E1DF,S2I(EXExecuteScript("(require'jass.slk').unit["+I2S(GetUnitTypeId(GetTriggerUnit()))+"].stockStart")))
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$EEA5806B,0)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E3A37E2,18)
set Z9=CreateTimer()
call SaveUnitHandle(Vn,GetHandleId(Z9),$458B7DE9,GetTriggerUnit())
call SaveInteger(Vn,GetHandleId(Z9),$ACBD688D,LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$ACBD688D))
call SaveInteger(Vn,GetHandleId(Z9),$EEA5806B,LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$EEA5806B))
call SavePlayerHandle(Vn,GetHandleId(Z9),'HeiF',LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))
call TimerStart(Z9,.02,true,function BSg)
set Z9=CreateTimer()
call SaveUnitHandle(Vn,GetHandleId(Z9),$458B7DE9,GetTriggerUnit())
call SaveInteger(Vn,GetHandleId(Z9),$9EECCB65,LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$9EECCB65))
call SaveInteger(Vn,GetHandleId(Z9),$1E3A37E2,LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E3A37E2))
call SavePlayerHandle(Vn,GetHandleId(Z9),'HeiF',LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))
call TimerStart(Z9,.03,true,function BSh)
set XZ[100*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))+98]=0
set XZ[1000*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))+98]=0
set XZ[100*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))+99]=0
set XZ[1000*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))+99]=0
call BIa(Zn[GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))],"SaveSourceType98",XZ[100*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))+98])
call BIa(Zn[GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))],"SaveSourceType99",XZ[100*GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))+99])
call BIa(Zn[GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))],"FirstSaveSource98",0)
call BIa(Zn[GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))],"FirstSaveSource99",0)
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
set Z9=null
endfunction
function BSj takes nothing returns nothing
set gn=CreateTrigger()
call BNT(gn,II)
call TriggerAddCondition(gn,Condition(function BSf))
call TriggerAddAction(gn,function BSi)
endfunction
function BSk takes nothing returns nothing
local integer Z7
set Z7=1+Yx
loop
exitwhen Z7>9+Yx
call BIa(Zn[1],"SaveSourceType"+I2S(Z7),XZ[100+Z7])
call BIa(Zn[2],"SaveSourceType"+I2S(Z7),XZ[200+Z7])
call BIa(Zn[3],"SaveSourceType"+I2S(Z7),XZ[300+Z7])
call BIa(Zn[4],"SaveSourceType"+I2S(Z7),XZ[400+Z7])
set Z7=Z7+1
endloop
set Yx=Yx+9
if Yx>=36 then
set Yx=0
else
endif
set Yv=Yv+1
if Yv>=1800 then
call DisableTrigger(GetTriggeringTrigger())
call DestroyTrigger(GetTriggeringTrigger())
else
endif
endfunction
function BSl takes nothing returns nothing
set go=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(go,15.)
call TriggerAddAction(go,function BSk)
endfunction
