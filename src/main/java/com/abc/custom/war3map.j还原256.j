function Bdx takes nothing returns boolean
return GetUnitTypeId(GetEventDamageSource())=='e018' and BM0()==true and BM1()==true
endfunction
function Bdy takes nothing returns nothing
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D,b8[3])
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25DAB820,GetUnitAbilityLevel(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D),'A061'))
if IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetEventDamageSource()))==true then
if DzAPI_Map_HasMallItem(GetOwningPlayer(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D)),"NBDZF")==true or Xb==true or DzAPI_Map_HasMallItem(GetOwningPlayer(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D)),"SH3")==true then
call SaveReal(Vn,GetHandleId(GetTriggeringTrigger())*aD,$BB4B7313,1.2*(200.*I2R(LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25DAB820))+I2R(GetHeroStatBJ(bj_HEROSTAT_STR,LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D),true))*(2.+2.*I2R(LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25DAB820)))))
else
call SaveReal(Vn,GetHandleId(GetTriggeringTrigger())*aD,$BB4B7313,1.*(200.*I2R(LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25DAB820))+I2R(GetHeroStatBJ(bj_HEROSTAT_STR,LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D),true))*(2.+2.*I2R(LoadInteger(Vn,GetHandleId(GetTriggeringTrigger())*aD,$25DAB820)))))
endif
call UnitDamageTarget(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$C303079D),GetTriggerUnit(),LoadReal(Vn,GetHandleId(GetTriggeringTrigger())*aD,$BB4B7313),false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_DIVINE,WEAPON_TYPE_WHOKNOWS)
else
call BM5(0.)
call UnitRemoveBuffsExBJ(bj_BUFF_POLARITY_NEGATIVE,bj_BUFF_RESIST_EITHER,GetTriggerUnit(),false,false)
endif
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
function Bdz takes nothing returns nothing
set im=CreateTrigger()
call BNP(im)
call TriggerAddCondition(im,Condition(function Bdx))
call TriggerAddAction(im,function Bdy)
endfunction
function Bd0 takes nothing returns boolean
