function BT9 takes nothing returns nothing
set cV=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(cV,EVENT_PLAYER_HERO_LEVEL)
call TriggerAddCondition(cV,Condition(function BT7))
call TriggerAddAction(cV,function BT8)
endfunction
function BUB takes nothing returns boolean
return IsUnitIllusionBJ(GetTriggerUnit())==false and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true
