call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call CreateTextTagLocBJ("|cff80ff80持有|cffffcc00骑士剑|cff80ff80的勇者..
可开启此门",LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8),50.,12.5,100.,100.,100.,0)
