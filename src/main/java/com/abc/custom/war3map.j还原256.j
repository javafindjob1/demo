endfunction
function DDU takes nothing returns boolean
return IsUnitAliveBJ(GetFilterUnit())==true and (IsUnitAlly(GetFilterUnit(),Player(5))==true and (IsUnitType(GetFilterUnit(),UNIT_TYPE_MECHANICAL)==false and S2R(EXExecuteScript("(require'jass.slk').unit["+I2S(GetUnitTypeId(GetFilterUnit()))+"].moveHeight"))<=50.))
endfunction
function DDV takes nothing returns boolean
return IsUnitAliveBJ(GetFilterUnit())==true and IsUnitEnemy(GetFilterUnit(),Player(6))==true
endfunction
function DDW takes nothing returns nothing
call UnitDamageTarget(sb[15],GetEnumUnit(),LoadReal(Vn,GetHandleId(GetExpiredTimer()),$BB4B7313)*1.,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)
endfunction
function DDX takes nothing returns nothing
call SaveInteger(Vn,GetHandleId(GetExpiredTimer()),$2970F80D,LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$2970F80D)+1)
if ModuloInteger(LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$2970F80D),2)==0 then
call AddSpecialEffectLocBJ(LoadLocationHandle(Vn,GetHandleId(GetExpiredTimer()),$72E90FA0),"Abilities\\Weapons\\BallsOfFireMissile\\BallsOfFireMissile.mdl")
call EXSetEffectSize(bj_lastCreatedEffect,2.5)
call EXSetEffectZ(bj_lastCreatedEffect,15.)
call DestroyEffect(GetLastCreatedEffectBJ())
else
endif
if LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$2970F80D)==20 then
call AddSpecialEffectLocBJ(LoadLocationHandle(Vn,GetHandleId(GetExpiredTimer()),$72E90FA0),"war3mapImported\\Nzoth.mdl")
call SaveEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586,GetLastCreatedEffectBJ())
call EXEffectMatRotateZ(LoadEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586),310.)
call EXSetEffectSize(LoadEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586),1.85)
call EXSetEffectSpeed(bj_lastCreatedEffect,.8)
call EXSetEffectZ(LoadEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586),-450.)
call TriggerExecute(BG6)
else
endif
if LoadInteger(Vn,GetHandleId(GetExpiredTimer()),$2970F80D)>20 then
call SaveReal(Vn,GetHandleId(GetExpiredTimer()),$C914A483,LoadReal(Vn,GetHandleId(GetExpiredTimer()),$C914A483)+16.)
call EXSetEffectZ(LoadEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586),-450.+LoadReal(Vn,GetHandleId(GetExpiredTimer()),$C914A483))
call SaveGroupHandle(Vn,GetHandleId(GetExpiredTimer()),$1E6D6D2F,BM9(Mi,Condition(function DDU)))
call SaveGroupHandle(Vn,GetHandleId(GetExpiredTimer()),$214C62CC,BM8(250.,LoadLocationHandle(Vn,GetHandleId(GetExpiredTimer()),$72E90FA0),Condition(function DDV)))
call ForGroupBJ(LoadGroupHandle(Vn,GetHandleId(GetExpiredTimer()),$214C62CC),function DDW)
call DestroyGroup(LoadGroupHandle(Vn,GetHandleId(GetExpiredTimer()),$214C62CC))
call GroupClear(LoadGroupHandle(Vn,GetHandleId(GetExpiredTimer()),$214C62CC))
else
endif
if LoadReal(Vn,GetHandleId(GetExpiredTimer()),$C914A483)>=510. then
call SetUnitX(sb[15],GetLocationX(LoadLocationHandle(Vn,GetHandleId(GetExpiredTimer()),$72E90FA0)))
call SetUnitY(sb[15],GetLocationY(LoadLocationHandle(Vn,GetHandleId(GetExpiredTimer()),$72E90FA0)))
call EXSetEffectSize(LoadEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586),0.)
call DestroyEffect(LoadEffectHandle(Vn,GetHandleId(GetExpiredTimer()),$CDD27586))
call DisplayTimedTextToForce(GetPlayersAll(),5.,"|cffffcc00第十五层BOSS：|cffff0000孕核魔胎哈桑|r")
call PlaySoundBJ(i)
call RemoveLocation(LoadLocationHandle(Vn,GetHandleId(GetExpiredTimer()),$72E90FA0))
call FlushChildHashtable(Vn,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
else
endif
endfunction
