function C8w takes nothing returns boolean
return IsUnitAliveBJ(GetFilterUnit())==true and (IsUnitAlly(GetFilterUnit(),Player(5))==true and (IsUnitType(GetFilterUnit(),UNIT_TYPE_MECHANICAL)==false and S2R(EXExecuteScript("(require'jass.slk').unit["+I2S(GetUnitTypeId(GetFilterUnit()))+"].moveHeight"))<=50.))
