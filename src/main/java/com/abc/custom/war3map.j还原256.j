call BJ2("YDWEStringFormula."+I2S(VC))
return true
endfunction
function DFL takes nothing returns boolean
local integer VC=U8
call BOK(VH[VC])
call BOK(VI[VC])
call GroupClear(VJ[VC])
call DestroyGroup(VJ[VC])
call PauseTimer(VI[VC])
call DestroyTimer(VI[VC])
call BHd(VM[VC])
call BHd(VN[VC])
call BHd(VO[VC])
set VP[VC]=null
set VQ[VC]=null
set VH[VC]=null
set VJ[VC]=null
set VI[VC]=null
set VR[VC]=0
set VS[VC]=0
set VT[VC]=0
set VU[VC]=""
set VV[VC]=""
set VW[VC]=""
set VX[VC]=""
return true
endfunction
function DFM takes nothing returns boolean
local integer VC=U8
local integer VZ=0
loop
exitwhen VZ==Va
set Vb[Vc[VC]+VZ]=0
set Vd[Ve[VC]+VZ]=0
set VZ=VZ+1
endloop
set Vf[VC]=""
return true
endfunction
function DFN takes nothing returns nothing
set U7[1]=CreateTrigger()
set U7[2]=U7[1]
call TriggerAddCondition(U7[1],Condition(function DFK))
set VD[9]=CreateTrigger()
set VD[10]=VD[9]
set VD[11]=VD[9]
set VD[12]=VD[9]
call TriggerAddCondition(VD[9],Condition(function DFL))
set VY=CreateTrigger()
call TriggerAddCondition(VY,Condition(function DFM))
call ExecuteFunc("BNw")
call ExecuteFunc("BN0")
endfunction
