call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：一切都是缘分啊。")
call TriggerSleepAction(2.5)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffff77ff哥布林神棍坎特|r：好好休息一晚吧，这里很安全，而且你可以找我|cff808000合成顶级的装备|！")
