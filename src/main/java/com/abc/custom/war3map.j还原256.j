function BaS takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and IsUnitIllusionBJ(GetTriggerUnit())==false and GetUnitLevel(GetTriggerUnit())==1 and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3) and LoadInteger(VB,GetHandleId(GetTriggerUnit()),$BC0452BD)==0
endfunction
function BaT takes nothing returns nothing
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SavePlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF',GetOwningPlayer(GetTriggerUnit()))
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$BC0452BD,1)
if Xp[GetConvertedPlayerId(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))]>=4 then
call UnitAddAbility(GetTriggerUnit(),'A0L6')
call SetPlayerAbilityAvailable(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'),'A0L6',false)
else
endif
if DzAPI_Map_GetMapLevel(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'))>=50 then
call UnitAddAbility(GetTriggerUnit(),'A0L7')
call SetPlayerAbilityAvailable(LoadPlayerHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,'HeiF'),'A0L7',false)
else
endif
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
function BaU takes nothing returns nothing
set hS=CreateTrigger()
call BNT(hS,DX)
call TriggerAddCondition(hS,Condition(function BaS))
call TriggerAddAction(hS,function BaT)
endfunction
function BaV takes nothing returns nothing
