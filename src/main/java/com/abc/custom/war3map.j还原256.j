function Ccw takes nothing returns nothing
local integer bw
if GetItemTypeId(GetManipulatedItem())=='I09D' then
call SetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_LIFE,GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_LIFE)+3000.)
call SetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE,GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE)+3000.)
else
endif
if GetItemTypeId(GetManipulatedItem())=='I05G' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$FBAC17A7)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$FBAC17A7,1)
call SetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_LIFE,GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_LIFE)+5000.)
call SetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE,GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE)+5000.)
else
call KillUnit(GetTriggerUnit())
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I05H' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$755DDD6D)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$755DDD6D,1)
else
call KillUnit(GetTriggerUnit())
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I05I' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$4E562CB5)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$4E562CB5,1)
else
call KillUnit(GetTriggerUnit())
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I068' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$233BC15B)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$233BC15B,1)
else
call SetUnitManaPercentBJ(GetTriggerUnit(),0.)
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I069' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$98B46F73)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$98B46F73,1)
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,100)
call ModifyHeroStat(bj_HEROSTAT_AGI,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,100)
call ModifyHeroStat(bj_HEROSTAT_INT,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,100)
else
call SetUnitManaPercentBJ(GetTriggerUnit(),0.)
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I080' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$7A1744F0)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$7A1744F0,1)
else
call SetUnitLifePercentBJ(GetTriggerUnit(),7.)
call SetUnitManaPercentBJ(GetTriggerUnit(),20.)
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I081' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$E8290429)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$E8290429,1)
else
call SetUnitLifePercentBJ(GetTriggerUnit(),7.)
call SetUnitManaPercentBJ(GetTriggerUnit(),20.)
endif
else
endif
if GetItemTypeId(GetManipulatedItem())=='I071' then
if LoadInteger(VB,GetHandleId(GetTriggerUnit()),$CE61E63D)==0 then
call SaveInteger(VB,GetHandleId(GetTriggerUnit()),$CE61E63D,1)
call SetHeroLevel(GetTriggerUnit(),GetUnitLevel(GetTriggerUnit())+1,true)
call AddSpecialEffectTargetUnitBJ("origin",GetTriggerUnit(),"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
else
set bw=1
loop
exitwhen bw>6
call UnitRemoveItemFromSlotSwapped(bw,GetTriggerUnit())
set bw=bw+1
endloop
call KillUnit(GetTriggerUnit())
endif
else
endif
call AddSpecialEffectTargetUnitBJ("origin",GetTriggerUnit(),"Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
call BOl(.5,bj_lastCreatedEffect)
endfunction
