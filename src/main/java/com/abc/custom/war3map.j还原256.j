function BN8 takes nothing returns nothing
local integer WE=0
local integer Vz=BNr(GetItemTypeId(GetManipulatedItem()))
local integer V2=StringLength(V0[Vz])/V1[Vz]
local integer WD=0
local integer WH=0
local integer V7=0
local integer WL=0
local integer VZ=0
local integer WN=0
local boolean WC=false
local item V5=null
local item V3=GetManipulatedItem()
local unit V4=GetTriggerUnit()
local item array V6
local integer array V8
local integer array V9
local integer array WK
set VZ=0
loop
exitwhen VZ==6
set V5=UnitItemInSlot(V4,VZ)
if V5!=null then
set V6[V7]=V5
set V8[V7]=GetItemTypeId(V5)
set V9[V7]=BN7(V5)
if V5==V3 then
set WC=true
endif
set V7=V7+1
endif
set VZ=VZ+1
set V5=null
endloop
if WC==false then
set V6[V7]=V3
set V8[V7]=GetItemTypeId(V3)
set V9[V7]=1
set V7=V7+1
endif
loop
exitwhen WD==V2
set WE=BNt(Vz,WD)
set WH=StringLength(WI[WE])/WJ[WE]-1
set VZ=0
loop
exitwhen VZ==V7
set WK[VZ]=V9[VZ]
set VZ=VZ+1
endloop
set VZ=0
loop
set WL=WM[BNy(WE,VZ)]
exitwhen VZ==WH
set WN=0
loop
exitwhen WN==V7
if V8[WN]==WL and WK[WN]>0 then
set WK[WN]=WK[WN]-1
exitwhen true
endif
set WN=WN+1
endloop
exitwhen WN==V7
set VZ=VZ+1
endloop
if VZ==WH then
if GetRandomInt(0,99)<WO[WE] then
if WP[WE]!=null then
call DestroyEffect(AddSpecialEffectTarget(WP[WE],V4,"origin"))
endif
if WQ[WE]!=null then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30,WQ[WE])
endif
set VZ=0
loop
exitwhen VZ==V7
if WK[VZ]>0 and GetItemCharges(V6[VZ])>0 then
call SetItemCharges(V6[VZ],WK[VZ])
elseif WK[VZ]==0 then
call RemoveItem(V6[VZ])
endif
set VZ=VZ+1
endloop
set V5=CreateItem(WL,GetUnitX(V4),GetUnitY(V4))
if GetItemCharges(V5)>0 then
call SetItemCharges(V5,1)
set VZ=0
loop
exitwhen VZ==V7
if V8[VZ]==WL then
call RemoveItem(V6[VZ])
call SetItemCharges(V5,WK[VZ]+1)
endif
set VZ=VZ+1
endloop
endif
call UnitAddItem(V4,V5)
set WR=V5
call BNi()
elseif WU[WE] then
set VZ=0
loop
exitwhen VZ==V7
if WK[VZ]>0 and GetItemCharges(V6[VZ])>0 then
call SetItemCharges(V6[VZ],WK[VZ])
elseif WK[VZ]==0 then
call RemoveItem(V6[VZ])
endif
set VZ=VZ+1
endloop
endif
set V5=null
exitwhen true
endif
set WD=WD+1
endloop
if WC==false then
call RemoveItem(V3)
endif
set VZ=0
loop
exitwhen VZ==V7
set V6[VZ]=null
set VZ=VZ+1
endloop
set V3=null
set V4=null
set V5=null
endfunction
