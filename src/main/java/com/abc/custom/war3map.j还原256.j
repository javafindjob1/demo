call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：哎？你是怎么知道的？")
