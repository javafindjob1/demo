call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8,GetRectCenter(B1))
if IsQuestDiscovered(as[1])==false then
call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"梦境之门","","ReplaceableTextures\\CommandButtons\\BTNUltravision.blp")
set as[1]=GetLastCreatedQuestBJ()
else
endif
