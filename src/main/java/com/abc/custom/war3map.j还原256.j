function C92 takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and IsUnitAlly(GetTriggerUnit(),Player(5))==true and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and GetOwningPlayer(GetTriggerUnit())==Player(0) or GetOwningPlayer(GetTriggerUnit())==Player(1) or GetOwningPlayer(GetTriggerUnit())==Player(2) or GetOwningPlayer(GetTriggerUnit())==Player(3)
endfunction
function C93 takes nothing returns nothing
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisableTrigger(GetTriggeringTrigger())
call DisplayTextToForce(GetPlayersAll(),"|cffffcc00"+GetHeroProperName(GetTriggerUnit())+"|r：达顿教授？你怎么也过来了...")
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授|r：我看附近怪物不多，就走过来了。不用担心，我带了激光炮防身。")
call TriggerSleepAction(3.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisplayTextToForce(GetPlayersAll(),"|cff80ff80达顿教授|r：倒是这颗巨卵很诡异....唔...里面究竟是什么呢....")
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
