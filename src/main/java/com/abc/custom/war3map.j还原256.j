function BNX takes unit eI,unit eJ returns nothing
local item array eK
local item array eL
local integer VZ=0
call BKL(I2S(BJz(eI)),"YDWEItemAbilitySystemTriggerClose",true)
call SetUnitOwner(eJ,GetOwningPlayer(eI),false)
loop
exitwhen VZ>5
if UnitItemInSlot(eI,VZ)!=null then
set eK[VZ]=UnitItemInSlot(eI,VZ)
call UnitRemoveItemFromSlot(eI,VZ)
endif
if UnitItemInSlot(eJ,VZ)!=null then
set eL[VZ]=UnitItemInSlot(eJ,VZ)
call UnitRemoveItemFromSlot(eJ,VZ)
endif
set VZ=VZ+1
endloop
set VZ=0
loop
exitwhen VZ>5
if eK[VZ]==null then
call UnitAddItem(eJ,CreateItem('stpg',GetUnitX(eJ),GetUnitY(eJ)))
else
call UnitAddItem(eJ,eK[VZ])
endif
set VZ=VZ+1
endloop
set VZ=0
loop
exitwhen VZ>5
if eL[VZ]==null then
call UnitAddItem(eI,CreateItem('stpg',GetUnitX(eI),GetUnitY(eI)))
else
call UnitAddItem(eI,eL[VZ])
endif
set VZ=VZ+1
endloop
set VZ=0
loop
exitwhen VZ>5
if GetItemTypeId(UnitItemInSlot(eI,VZ))=='stpg' then
call RemoveItem(UnitItemInSlot(eI,VZ))
endif
if GetItemTypeId(UnitItemInSlot(eJ,VZ))=='stpg' then
call RemoveItem(UnitItemInSlot(eJ,VZ))
endif
set VZ=VZ+1
endloop
set VZ=0
loop
exitwhen VZ>5
set eK[VZ]=null
set eL[VZ]=null
set VZ=VZ+1
endloop
call SetUnitOwner(eJ,Player(PLAYER_NEUTRAL_PASSIVE),false)
call BKL(I2S(BJz(eI)),"YDWEItemAbilitySystemTriggerClose",false)
endfunction
function BNY takes nothing returns boolean
local unit Sy=null
local trigger br=GetTriggeringTrigger()
local unit eD=GetTriggerUnit()
local integer eE=BKB(I2S(BJz(br)),"Ability")
local integer eH=BKB(I2S(BJz(br)),"ItemSlotMax")
local integer VZ=0
if GetSpellAbilityId()!=eE then
set Sy=null
set br=null
set eD=null
return false
endif
if eH==1 then
set Sy=null
set br=null
set eD=null
return false
endif
set VZ=BKB(I2S(BJz(br)),"ItemSlotNum")
set VZ=VZ+1
if VZ>eH then
set VZ=1
endif
call BJ8(I2S(BJz(br)),"ItemSlotNum",VZ)
set Sy=BKR(I2S(BJz(br)),I2S(VZ))
call BNX(eD,Sy)
call SetUnitAbilityLevel(eD,eE,VZ)
if VZ==1 then
call BKP(I2S(BJz(br)),I2S(eH),Sy)
else
call BKP(I2S(BJz(br)),I2S(VZ-1),Sy)
endif
set Sy=null
set br=null
set eD=null
return false
endfunction
function BNZ takes unit eD,integer eE,integer eF,integer eG returns nothing
local integer VZ=BKB(I2S(BJz(eD)),"MulItemSlotByAbility")
local trigger br=null
local unit Sy=null
if VZ==0 then
set br=CreateTrigger()
call TriggerRegisterUnitEvent(br,eD,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(br,Condition(function BNY))
call BKr(I2S(BJz(eD)),"MulItemSlotByAbility",br)
call BJ8(I2S(BJz(br)),"Ability",eE)
call BJ8(I2S(BJz(br)),"ItemSlotMax",eG)
call BJ8(I2S(BJz(br)),"ItemSlotNum",1)
if eG>1 then
loop
exitwhen eG==1
set Sy=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),eF,0,0,0)
call BKL(I2S(BJz(Sy)),"YDWEItemAbilitySystemTriggerClose",true)
call BKP(I2S(BJz(br)),I2S(eG),Sy)
set eG=eG-1
set Sy=null
endloop
endif
endif
set br=null
endfunction
function BNc takes real ch,location nB,code xJ returns nothing
local rect Z2
local real xK=GetLocationX(nB)
local real xL=GetLocationY(nB)
if ch>=0 then
set bj_enumDestructableCenter=nB
set bj_enumDestructableRadius=ch
set Z2=Rect(xK-ch,xL-ch,xK+ch,xL+ch)
call EnumDestructablesInRect(Z2,Filter(function BMy),xJ)
call RemoveRect(Z2)
set Z2=null
endif
endfunction
function BNd takes rect Z2 returns group
return BM9(Z2,null)
endfunction
function BNe takes nothing returns nothing
local timer Vt=GetExpiredTimer()
local unit eD=BKR(I2S(BJz(Vt)),"Hero")
local real fF=BKF(I2S(BJz(Vt)),"Angle")
local integer fS=BKB(I2S(BJz(Vt)),"steeps")
local integer fM=BKB(I2S(BJz(Vt)),"steepsMax")
local real fJ=BKF(I2S(BJz(Vt)),"heightMax")
local real fQ=BKF(I2S(BJz(Vt)),"dist")
local real fR=BKF(I2S(BJz(Vt)),"dheig")
local real fN=BKF(I2S(BJz(Vt)),"OriginHeight")
local real fK=BKF(I2S(BJz(Vt)),"X")
local real fL=BKF(I2S(BJz(Vt)),"Y")
local real fU=0
local real fV=0
local real fW=0
local integer fT=fP
local integer fO=BKB(I2S(BJz(eD)),"lvUnitMove")
if fS<fM and fT>=fO then
set fU=fK+fS*fQ*Cos(fF*3.14159/180.)
set fV=fL+fS*fQ*Sin(fF*3.14159/180.)
set fU=BMV(fU)
set fV=BMW(fV)
call SetUnitX(eD,fU)
call SetUnitY(eD,fV)
set fS=fS+1
call BJ8(I2S(BJz(Vt)),"steeps",fS)
set fW=(-(2*I2R(fS)*fR-1)*(2*I2R(fS)*fR-1)+1)*fJ+fN
call SetUnitFlyHeight(eD,fW,99999)
call SetUnitFacing(eD,fF)
else
call SetUnitFlyHeight(eD,fN,99999)
call SetUnitPathing(eD,true)
call DestroyTimer(Vt)
call BJ2(I2S(BJz(Vt)))
call BJ8(I2S(BJz(eD)),"lvUnitMove",0)
call BMi(eD,2)
endif
set Vt=null
set eD=null
endfunction
function BNf takes unit eD,real fF,real fG,real fH,real fI,real fJ returns nothing
local timer Vt=null
local real fK=GetUnitX(eD)
local real fL=GetUnitY(eD)
local integer fM=R2I(fH/fI)
local integer fS=0
local real fQ=fG/fM
local real fR=1./fM
local real fN=GetUnitFlyHeight(eD)
local integer fO=BKB(I2S(BJz(eD)),"lvUnitMove")
if fP<=fO then
return
endif
set Vt=CreateTimer()
call BJ8(I2S(BJz(eD)),"lvUnitMove",fP)
