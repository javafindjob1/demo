call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$72E90FA0,GetDestructableLoc(GetDyingDestructable()))
if GetDestructableTypeId(GetDyingDestructable())=='B011' then
