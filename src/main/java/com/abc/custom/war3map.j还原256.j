set YQ=YQ+1
if YQ==9999 then
set YQ=1
else
endif
call SaveGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E6D6D2F,BM9(Eu,Condition(function C8w)))
call ForGroupBJ(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E6D6D2F),function C8x)
call GroupClear(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E6D6D2F))
call DestroyGroup(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$1E6D6D2F))
