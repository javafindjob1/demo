endfunction
function BO8 takes nothing returns boolean
return GetUnitPointValue(GetFilterUnit())==964 and IsUnitType(GetFilterUnit(),UNIT_TYPE_MECHANICAL)==true
endfunction
function BO9 takes nothing returns nothing
call SetUnitAnimation(GetEnumUnit(),"stand work")
endfunction
function BPB takes nothing returns nothing
call StopMusic(true)
call EndThematicMusic()
call ClearMapMusic()
call TriggerExecute(aB)
call StartTimerBJ(Yl,false,30.)
call SetTimeOfDay(10.)
call FlushChildHashtable(Vn,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
endfunction
function BPC takes nothing returns nothing
local integer Z7
local timer Z9
set Zn[1]=Player(0)
set Zn[2]=Player(1)
set Zn[3]=Player(2)
set Zn[4]=Player(3)
set YS=.03
set XJ[1]="|cff80ff80"
set XJ[2]="|cffffcc00"
set XJ[3]="|cffccffff"
set XJ[4]="|cffff99cc"
if GetPlayerController(Player(0))==MAP_CONTROL_USER and GetPlayerSlotState(Player(0))==PLAYER_SLOT_STATE_PLAYING then
call ForceAddPlayer(YG,Player(0))
else
endif
if GetPlayerController(Player(1))==MAP_CONTROL_USER and GetPlayerSlotState(Player(1))==PLAYER_SLOT_STATE_PLAYING then
call ForceAddPlayer(YG,Player(1))
else
endif
if GetPlayerController(Player(2))==MAP_CONTROL_USER and GetPlayerSlotState(Player(2))==PLAYER_SLOT_STATE_PLAYING then
call ForceAddPlayer(YG,Player(2))
else
endif
if GetPlayerController(Player(3))==MAP_CONTROL_USER and GetPlayerSlotState(Player(3))==PLAYER_SLOT_STATE_PLAYING then
call ForceAddPlayer(YG,Player(3))
else
endif
set XW=CountPlayersInForceBJ(YG)
call TriggerExecute(Zo)
call TriggerExecute(Zp)
call TriggerExecute(Zq)
call TriggerExecute(Zr)
call TriggerExecute(Zs)
call TriggerExecute(Zt)
call TriggerExecute(Zu)
call TriggerExecute(Zv)
call TriggerExecute(Zw)
call TriggerExecute(Zx)
call TriggerExecute(Zy)
call TriggerExecute(Zz)
call TriggerExecute(Z0)
call TriggerExecute(Z1)
call ForGroupBJ(BM9(GetPlayableMapRect(),Condition(function BO8)),function BO9)
call TriggerExecute(Z6)
call DisplayTimedTextToForce(GetPlayersAll(),1.5,"地图加载中......")
set Z7=1
loop
exitwhen Z7>4
if DzAPI_Map_HasMallItem(Zn[Z7],"GHLV2")==true then
call DisplayTimedTextToPlayer(Zn[Z7],0,0,4.,"公会Lv2奖励：|cff80ff80公会经验|r已激活！")
else
endif
if DzAPI_Map_HasMallItem(Zn[Z7],"GHLV3")==true then
call DisplayTimedTextToPlayer(Zn[Z7],0,0,4.,"公会Lv3奖励：|cffffcc00公会篮子|r已激活！")
else
endif
if DzAPI_Map_HasMallItem(Zn[Z7],"GHLV4")==true then
call DisplayTimedTextToPlayer(Zn[Z7],0,0,4.,"公会Lv4奖励：|cffffcc00公会药剂|r已激活！")
else
endif
if DzAPI_Map_HasMallItem(Zn[Z7],"1Y")==true then
call DisplayTimedTextToPlayer(Zn[Z7],0,0,5.,"|cffffff00超值金币|r已激活，增加200金币！")
else
endif
if DzAPI_Map_HasMallItem(Zn[Z7],"TQ1")==true then
call DisplayTimedTextToPlayer(Zn[Z7],0,0,5.,"|cffffff00经营之石|r已激活，购买装备时返还10%金币！")
else
endif
if BJa(Zn[Z7])!="星悦丶宏愿#8501" and DzAPI_Map_HasMallItem(Zn[Z7],"ATK1")==true then
call DisplayTimedTextToPlayer(Zn[Z7],0,0,5.,"|cffffcc00进攻卡|r已激活！！")
else
endif
set Z7=Z7+1
endloop
set Z9=CreateTimer()
call TimerStart(Z9,1.5,false,function BPB)
set Z9=null
endfunction
function BPD takes nothing returns nothing
set Zm=CreateTrigger()
call TriggerRegisterTimerEventSingle(Zm,0.)
call TriggerAddAction(Zm,function BPC)
endfunction
