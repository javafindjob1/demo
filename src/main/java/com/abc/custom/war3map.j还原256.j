function DDP takes nothing returns boolean
return IsUnitAliveBJ(GetFilterUnit())==true and (IsUnitAlly(GetFilterUnit(),Player(5))==true and (IsUnitType(GetFilterUnit(),UNIT_TYPE_MECHANICAL)==false and S2R(EXExecuteScript("(require'jass.slk').unit["+I2S(GetUnitTypeId(GetFilterUnit()))+"].moveHeight"))<=50.))
endfunction
function DDQ takes nothing returns nothing
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$32A9E4C8,GetUnitLoc(GetEnumUnit()))
if GetTerrainTypeBJ(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$32A9E4C8))=='Yhdg' and BNV(GetEnumUnit(),'I057')==false and BNV(GetEnumUnit(),'I089')==false and GetUnitTypeId(GetEnumUnit())!='H01E' then
call SaveReal(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$BB4B7313,1100.+450.*I2R(Wz))
if BNV(GetEnumUnit(),'plcl')==true then
call UnitDamageTarget(BD7,GetEnumUnit(),LoadReal(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$BB4B7313)*.3,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)
else
call UnitDamageTarget(BD7,GetEnumUnit(),LoadReal(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$BB4B7313)*.9,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)
endif
if ModuloInteger(YQ,3)==1 then
call AddSpecialEffectTargetUnitBJ("origin",GetEnumUnit(),"Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireDamage.mdl")
call BOl(1.,bj_lastCreatedEffect)
else
endif
else
endif
call RemoveLocation(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$32A9E4C8))
endfunction
