function C5X takes nothing returns nothing
local integer Z7
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call DisableTrigger(GetTriggeringTrigger())
call TriggerSleepAction(.5)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+1,Location(-3197.,2302.))
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+2,Location(-2973.,2493.))
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+3,Location(-2785.,2712.))
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+4,Location(-2551.,2935.))
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+5,Location(-2854.,2097.))
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+6,Location(-2596.,2314.))
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+7,Location(-2420.,2538.))
set Z7=1
loop
exitwhen Z7>7
call AddSpecialEffectLocBJ(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+Z7),"Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call CreateItemLoc(aE[GetRandomInt(1,6)],LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+Z7))
set Z7=Z7+1
endloop
call AddSpecialEffectLocBJ(Location(-3120.,2797.),"Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
call TriggerSleepAction(2.)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SetUnitPositionLocFacingBJ(TX,GetRectCenter(HL),315.)
set Z7=5-XW
loop
exitwhen Z7>7
call CreateNUnitsAtLoc(1,'ngh1',Player(6),LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8+Z7),315.)
call SaveInteger(VB,GetHandleId(GetLastCreatedUnit()),$2C26E10D,1)
set Z7=Z7+1
endloop
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
