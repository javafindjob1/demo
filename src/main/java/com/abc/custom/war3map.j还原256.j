exitwhen bw>4
if Xm[bw]>=3 and BJa(Zn[bw])!="星悦丶宏愿#8501" then
set Xm[bw]=0
else
endif
if XZ[100*bw+36]>=1002 then
set XZ[100*bw+36]=0
else
endif
if DzAPI_Map_HasMallItem(Zn[bw],"50K")==true and GetUnitTypeId(aW[bw])=='O01B' or GetUnitTypeId(aW[bw])=='O019' or GetUnitTypeId(aW[bw])=='H01E' or GetUnitTypeId(aW[bw])=='E03O' or GetUnitTypeId(aW[bw])=='E04L' or GetUnitTypeId(aW[bw])=='O00K' then
call CreateNUnitsAtLoc(1,'e04E',Zn[bw],GetUnitLoc(aW[bw]),bj_UNIT_FACING)
call IssueImmediateOrder(GetLastCreatedUnit(),"waterelemental")
else
endif
set bw=bw+1
endloop
