function BZq takes nothing returns nothing
set a5=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(a5,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddCondition(a5,Condition(function BZo))
call TriggerAddAction(a5,function BZp)
endfunction
function BZr takes nothing returns boolean
return IsUnitType(GetBuyingUnit(),UNIT_TYPE_HERO)==true and IsUnitIllusionBJ(GetBuyingUnit())==false and S2I(EXExecuteScript("(require'jass.slk').item["+I2S(GetItemTypeId(GetSoldItem()))+"].prio"))==365 and GetItemType(GetManipulatedItem())!=ITEM_TYPE_PERMANENT and GetItemType(GetManipulatedItem())!=ITEM_TYPE_CHARGED and GetItemType(GetManipulatedItem())!=ITEM_TYPE_POWERUP and GetItemType(GetManipulatedItem())!=ITEM_TYPE_ARTIFACT and GetItemType(GetManipulatedItem())!=ITEM_TYPE_PURCHASABLE and GetItemType(GetManipulatedItem())!=ITEM_TYPE_CAMPAIGN
endfunction
