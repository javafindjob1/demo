function BN4 takes integer VC returns string
local integer VZ=1
local integer WN
local integer bi
set Vf[VC]=""
loop
exitwhen VZ>be[VC]
if Vb[Vc[VC]+VZ]==0 or Vd[Ve[VC]+VZ]==0 then
set Vb[Vc[VC]+VZ]=Vb[Vc[VC]+be[VC]]
set Vd[Ve[VC]+VZ]=Vd[Ve[VC]+be[VC]]
set be[VC]=be[VC]-1
set VZ=VZ-1
else
set WN=VZ+1
loop
exitwhen WN>be[VC]
if Vb[Vc[VC]+WN]==0 or Vd[Ve[VC]+WN]==0 then
set Vb[Vc[VC]+WN]=Vb[Vc[VC]+be[VC]]
set Vd[Ve[VC]+WN]=Vd[Ve[VC]+be[VC]]
set be[VC]=be[VC]-1
set WN=WN-1
elseif Vb[Vc[VC]+VZ]>Vb[Vc[VC]+WN] then
set bi=Vb[Vc[VC]+VZ]
set Vb[Vc[VC]+VZ]=Vb[Vc[VC]+WN]
set Vb[Vc[VC]+WN]=bi
set bi=Vd[Ve[VC]+VZ]
set Vd[Ve[VC]+VZ]=Vd[Ve[VC]+WN]
set Vd[Ve[VC]+WN]=bi
elseif Vb[Vc[VC]+VZ]==Vb[Vc[VC]+WN] then
set Vd[Ve[VC]+VZ]=Vd[Ve[VC]+VZ]+Vd[Ve[VC]+WN]
set Vb[Vc[VC]+WN]=0
set WN=WN-1
endif
set WN=WN+1
endloop
set WN=Vd[Ve[VC]+VZ]
loop
exitwhen WN==0
set Vf[VC]=Vf[VC]+BNq(Vb[Vc[VC]+VZ],bg)
set WN=WN-1
endloop
endif
set VZ=VZ+1
endloop
return Vf[VC]
endfunction
