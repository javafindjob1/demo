function BVj takes nothing returns nothing
local integer aD=LoadInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set aD=aD+3
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,aD)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call SaveLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8,GetUnitLoc(GetTriggerUnit()))
call SaveGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$214C62CC,BM8(900.,LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8),Condition(function BVi)))
call SaveUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$B37CFB7B,FirstOfGroup(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$214C62CC)))
if GetOwningPlayer(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$B37CFB7B))==Player(PLAYER_NEUTRAL_PASSIVE) then
call SetUnitOwner(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$B37CFB7B),Player(5),true)
call QuestMessageBJ(GetPlayersAll(),bj_QUESTMESSAGE_ITEMACQUIRED,"|cffffcc00发现新的记忆石碑！|r")
call AddUnitAnimationProperties(LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$B37CFB7B),"stand alternate",true)
call PingMinimapLocForForce(GetPlayersAll(),LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8),1)
call PlaySoundBJ(G)
if RectContainsUnit(Ih,LoadUnitHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$B37CFB7B))==true then
call TriggerSleepAction(2)
call SaveInteger(Vn,GetHandleId(GetTriggeringTrigger()),$ECE825E7,aD)
call QuestMessageBJ(GetPlayersAll(),bj_QUESTMESSAGE_ITEMACQUIRED,"|cff80ff80记忆石碑是重要的传送点，也是生命和魔法的补给站。|r")
else
endif
else
endif
call RemoveLocation(LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8))
call GroupClear(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$214C62CC))
call DestroyGroup(LoadGroupHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$214C62CC))
call FlushChildHashtable(Vn,GetHandleId(GetTriggeringTrigger())*aD)
endfunction
