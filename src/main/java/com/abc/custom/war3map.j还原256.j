function BOC takes unit mN,unit mO,real fK,real fL,real VE,integer eF,integer mP,integer mQ,integer mR returns nothing
local unit mS=CreateUnit(GetOwningPlayer(mN),eF,fK,fL,GetUnitFacing(mN))
call UnitApplyTimedLife(mS,'BHwe',1.)
call UnitAddAbility(mS,mP)
call SetUnitAbilityLevel(mS,mP,mQ)
call SetUnitFlyHeight(mS,VE,0.)
call IssueTargetOrderById(mS,mR,mO)
set mS=null
endfunction
function BOE takes unit Sy,unit V4 returns boolean
return IsUnitType(Sy,UNIT_TYPE_MAGIC_IMMUNE)==false and IsUnitType(Sy,UNIT_TYPE_RESISTANT)==false and IsUnitType(Sy,UNIT_TYPE_SLEEPING)==false and GetUnitState(Sy,UNIT_STATE_LIFE)>.405 and IsUnitType(Sy,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(Sy)==false and IsUnitHidden(Sy)==false and IsUnitEnemy(Sy,GetOwningPlayer(V4)) and IsUnitVisible(Sy,GetOwningPlayer(V4))
endfunction
function BOF takes nothing returns boolean
local integer Vv=GetDestructableTypeId(GetFilterDestructable())
return Vv=='LTlt' or Vv=='ATtr' or Vv=='BTtw' or Vv=='KTtw' or Vv=='YTft' or Vv=='JTct' or Vv=='YTst' or Vv=='YTct' or Vv=='YTwt' or Vv=='JTtw' or Vv=='DTsh' or Vv=='FTtw' or Vv=='CTtr' or Vv=='ITtw' or Vv=='NTtw' or Vv=='OTtw' or Vv=='ZTtw' or Vv=='WTst' or Vv=='GTsh' or Vv=='VTlt' or Vv=='WTtw' or Vv=='ATtc' or Vv=='BTtc' or Vv=='CTtc' or Vv=='ITtc' or Vv=='NTtc' or Vv=='ZTtc'
endfunction
function BOG takes nothing returns boolean
local unit Sy=GetFilterUnit()
local integer mI=mJ
if not IsUnitInGroup(Sy,VJ[mI]) and mE[mI]!=0 and BOE(Sy,VP[mI]) then
call UnitDamageTarget(VP[mI],Sy,VR[mI],true,true,mK,mL,mM)
call DestroyEffect(AddSpecialEffectTarget(VU[mI],Sy,VX[mI]))
if VS[mI]>'0000' and VS[mI]!=null and VT[mI]>0 and VT[mI]!=null then
call BOC(VP[mI],Sy,l6[VN[mI]],l7[VN[mI]],GetUnitFlyHeight(VH[mI]),mT[mI],VS[mI],mU[mI],VT[mI])
endif
if not mC[mI] then
set mE[mI]=0
endif
set VQ[mI]=Sy
set Sy=null
return true
endif
set Sy=null
return false
endfunction
