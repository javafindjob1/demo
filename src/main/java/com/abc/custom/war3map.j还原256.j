call CreateQuestItemBJ(as[1],"----完成梦境之门里的剧情。")
set at[12]=GetLastCreatedQuestItemBJ()
call PlaySoundAtPointBJ(w,100,LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8),0)
call CreateTextTagLocBJ("|cff80ff80此处是梦境之门【荣誉】|r",LoadLocationHandle(Vn,GetHandleId(GetTriggeringTrigger())*aD,$32A9E4C8),50.,12.5,100.,100.,100.,0)
