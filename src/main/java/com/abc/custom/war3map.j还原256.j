function BNV takes unit ax,integer ay returns boolean
local integer Wo=0
if ay!=0 then
loop
if GetItemTypeId(UnitItemInSlot(ax,Wo))==ay then
return true
endif
set Wo=Wo+1
exitwhen Wo>=bj_MAX_INVENTORY
endloop
