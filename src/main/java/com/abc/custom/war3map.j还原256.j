if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true then
call SetUnitPositionLoc(GetTriggerUnit(),GetRectCenter(Hb))
call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()),GetRectCenter(Hb),0)
else
call KillUnit(GetTriggerUnit())
endif
else
endif
endfunction
