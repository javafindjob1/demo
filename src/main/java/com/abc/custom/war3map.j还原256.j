function BHW takes nothing returns integer
local integer VC=Vh
if VC!=0 then
set Vh=Vi[VC]
else
set Vj=Vj+1
set VC=Vj
endif
if VC>8190 then
return 0
endif
set Vk[VC]=1
set Vi[VC]=-1
return VC
endfunction
function BHY takes nothing returns integer
local integer VC=BHW()
local integer Vl
if VC==0 then
return 0
endif
set Vk[VC]=2
set Vl=VC
return VC
endfunction
function BHa takes nothing returns integer
local integer VC=l1
if VC!=0 then
set l1=l2[VC]
else
set l3=l3+1
